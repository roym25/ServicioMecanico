---
// src/pages/contacto.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Contáctanos | Servicio Mecánico"
  description="Ponte en contacto con nuestro taller mecánico para citas, presupuestos y asesoría automotriz. Estamos para atenderte."
>
  <!-- Hero / Cabecera -->
  <section class="bg-gradient-to-b from-primary to-[#182e4b] text-white py-14 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3.5 py-1 rounded-full bg-white/10 text-white/90 text-xs font-semibold tracking-wider uppercase mb-3 border border-white/15">
        Atención Inmediata
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-3">
        Contáctanos
      </h1>
      <p class="text-gray-200 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        ¿Tienes dudas sobre una avería o deseas agendar una revisión? Escríbenos, llámanos o visítanos directamente en el taller.
      </p>
    </div>
  </section>

  <!-- Contenido Principal: Formulario e Información -->
  <section class="py-16 sm:py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
        
        <!-- Columna Izquierda: Formulario de Contacto (lg:col-span-7) -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
            <div class="mb-8">
              <h2 class="text-2xl font-bold text-text mb-2">
                Envíanos un mensaje
              </h2>
              <p class="text-gray-600 text-sm">
                Completa el formulario y un asesor técnico responderá a tus preguntas a la brevedad.
              </p>
            </div>

            <form class="space-y-5" onsubmit="event.preventDefault(); alert('¡Gracias por contactarnos! Tu mensaje ha sido registrado.');">
              <!-- Nombre -->
              <div>
                <label for="nombre" class="block text-sm font-semibold text-text mb-1.5">
                  Nombre completo <span class="text-secondary">*</span>
                </label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  required
                  placeholder="Ej. Juan Pérez García"
                  class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-gray-50/50 text-text placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200 text-sm"
                />
              </div>

              <!-- Fila: Email y Teléfono -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <!-- Email -->
                <div>
                  <label for="email" class="block text-sm font-semibold text-text mb-1.5">
                    Correo electrónico <span class="text-secondary">*</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="tucorreo@ejemplo.com"
                    class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-gray-50/50 text-text placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200 text-sm"
                  />
                </div>

                <!-- Teléfono -->
                <div>
                  <label for="telefono" class="block text-sm font-semibold text-text mb-1.5">
                    Teléfono <span class="text-secondary">*</span>
                  </label>
                  <input
                    type="tel"
                    id="telefono"
                    name="telefono"
                    required
                    placeholder="Ej. 55 1234 5678"
                    class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-gray-50/50 text-text placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200 text-sm"
                  />
                </div>
              </div>

              <!-- Servicio de Interés -->
              <div>
                <label for="servicio" class="block text-sm font-semibold text-text mb-1.5">
                  Servicio requerido <span class="text-gray-400 font-normal">(Opcional)</span>
                </label>
                <select
                  id="servicio"
                  name="servicio"
                  class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-gray-50/50 text-text focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200 text-sm"
                >
                  <option value="">Selecciona un servicio</option>
                  <option value="mecanica-general">Mecánica General</option>
                  <option value="frenos">Revisión o Cambio de Frenos</option>
                  <option value="electrico">Sistema Eléctrico / Batería</option>
                  <option value="ac">Aire Acondicionado</option>
                  <option value="aceite">Cambio de Aceite y Filtros</option>
                  <option value="diagnostico">Diagnóstico / Escaneo Computarizado</option>
                  <option value="otro">Otro servicio / Consulta general</option>
                </select>
              </div>

              <!-- Mensaje -->
              <div>
                <label for="mensaje" class="block text-sm font-semibold text-text mb-1.5">
                  Mensaje o detalle de la falla <span class="text-secondary">*</span>
                </label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  rows="4"
                  required
                  placeholder="Describe la marca, modelo, año de tu auto y cualquier síntoma o falla que presente..."
                  class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-gray-50/50 text-text placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-200 text-sm resize-y"
                ></textarea>
              </div>

              <!-- Botón Submit -->
              <div>
                <button
                  type="submit"
                  class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-lg bg-secondary text-white font-semibold hover:bg-secondary/90 shadow-md hover:shadow-lg transition-all duration-200 cursor-pointer"
                >
                  <span>Enviar Mensaje</span>
                  <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Columna Derecha: Información de Contacto, Horarios y Mapa (lg:col-span-5) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Tarjeta de Información de Contacto -->
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-7">
            <h3 class="text-lg font-bold text-text mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
              <span class="text-secondary">📍</span> Información del Taller
            </h3>
            
            <ul class="space-y-4 text-sm">
              <li class="flex items-start gap-3.5">
                <div class="w-9 h-9 rounded-lg bg-red-50 text-secondary flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <span class="font-semibold text-text block">Dirección</span>
                  <span class="text-gray-600">Av. Principal #123, Zona Industrial</span>
                </div>
              </li>

              <li class="flex items-start gap-3.5">
                <div class="w-9 h-9 rounded-lg bg-blue-50 text-primary flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <span class="font-semibold text-text block">Teléfono / WhatsApp</span>
                  <a href="tel:+525512345678" class="text-primary hover:underline">+52 (55) 1234-5678</a>
                </div>
              </li>

              <li class="flex items-start gap-3.5">
                <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <span class="font-semibold text-text block">Correo Electrónico</span>
                  <a href="mailto:contacto@serviciomecanico.com" class="text-primary hover:underline">contacto@serviciomecanico.com</a>
                </div>
              </li>
            </ul>
          </div>

          <!-- Horario de Atención -->
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-7">
            <h3 class="text-lg font-bold text-text mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
              <span class="text-primary">🕒</span> Horario de Atención
            </h3>
            <ul class="space-y-2.5 text-sm">
              <li class="flex justify-between items-center py-1 border-b border-gray-50">
                <span class="font-medium text-gray-700">Lunes a Viernes</span>
                <span class="text-text font-bold">8:00 AM – 6:00 PM</span>
              </li>
              <li class="flex justify-between items-center py-1 border-b border-gray-50">
                <span class="font-medium text-gray-700">Sábados</span>
                <span class="text-text font-bold">8:00 AM – 2:00 PM</span>
              </li>
              <li class="flex justify-between items-center py-1 text-gray-500">
                <span class="font-medium">Domingos</span>
                <span class="text-secondary font-semibold">Cerrado</span>
              </li>
            </ul>
          </div>

          <!-- Placeholder del Mapa -->
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-4 border-b border-gray-100 flex items-center justify-between">
              <span class="text-sm font-bold text-text">Ubicación en el Mapa</span>
              <span class="text-xs text-gray-500">Zona Industrial</span>
            </div>
            <div class="relative bg-slate-100 h-56 flex flex-col items-center justify-center text-center p-6 border-b border-gray-100">
              <!-- Mapa decorativo simulado con grid y pin -->
              <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#1E3A5F_1.5px,transparent_1.5px)] [background-size:16px_16px]"></div>
              
              <div class="relative z-10">
                <div class="w-12 h-12 rounded-full bg-secondary text-white flex items-center justify-center text-xl shadow-lg mx-auto mb-2 animate-bounce">
                  📍
                </div>
                <p class="font-bold text-text text-sm mb-1">Taller Servicio Mecánico</p>
                <p class="text-xs text-gray-500 max-w-xs mb-3">Av. Principal #123, Zona Industrial</p>
                <a
                  href="https://maps.google.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md bg-primary text-white text-xs font-medium hover:bg-primary/90 transition-colors shadow-sm"
                >
                  <span>Abrir en Google Maps</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>
</MainLayout>
