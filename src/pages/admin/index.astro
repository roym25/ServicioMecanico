---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard">
  <div class="mb-1 flex items-baseline gap-3">
    <h1 class="text-2xl font-bold text-[#1E3A5F]">Panel de Control</h1>
    <p class="text-gray-600 text-sm hidden sm:block">Resumen general del taller mecánico</p>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
    <!-- Clientes -->
    <a href="/admin/clientes" class="block bg-white rounded-xl shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200 border border-gray-100 p-4 flex items-center justify-between group cursor-pointer">
      <div>
        <p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-0.5 group-hover:text-secondary transition-colors">Total Clientes</p>
        <h3 id="stat-clientes" class="text-3xl font-bold text-[#1E3A5F]">--</h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
    </a>
    <!-- Vehículos -->
    <a href="/admin/vehiculos" class="block bg-white rounded-xl shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200 border border-gray-100 p-4 flex items-center justify-between group cursor-pointer">
      <div>
        <p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-0.5 group-hover:text-accent transition-colors">Total Vehículos</p>
        <h3 id="stat-vehiculos" class="text-3xl font-bold text-[#1E3A5F]">--</h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-accent/10 text-accent flex items-center justify-center group-hover:bg-accent group-hover:text-white transition-colors">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
      </div>
    </a>
    <!-- Trabajos -->
    <a href="/admin/trabajos" class="block bg-white rounded-xl shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200 border border-gray-100 p-4 flex items-center justify-between group cursor-pointer">
      <div>
        <p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-0.5 group-hover:text-primary transition-colors">Trabajos este mes</p>
        <h3 id="stat-trabajos" class="text-3xl font-bold text-[#1E3A5F]">--</h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
      </div>
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <!-- Main Col: Trabajos -->
    <div class="lg:col-span-2 space-y-4">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
          <h2 class="text-lg font-bold text-[#1E3A5F]">Últimos Trabajos</h2>
          <a href="/admin/trabajos" class="text-sm font-semibold text-secondary hover:text-secondary/80 transition flex items-center gap-1">Ver todos &rarr;</a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-max text-sm">
            <thead>
              <tr class="bg-gray-50/50 text-gray-500 text-xs uppercase border-b border-gray-100">
                <th class="px-4 py-2 font-semibold">Fecha</th>
                <th class="px-4 py-2 font-semibold">Vehículo</th>
                <th class="px-4 py-2 font-semibold">Tipo</th>
                <th class="px-4 py-2 font-semibold text-center">Estado</th>
              </tr>
            </thead>
            <tbody id="tb-trabajos" class="divide-y divide-gray-100">
              <tr><td colspan="4" class="px-4 py-6 text-center text-gray-500">Cargando trabajos...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Sidebar Col: Acciones & Clientes -->
    <div class="space-y-3">
      <!-- Acciones Rápidas -->
      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex flex-col justify-center">
        <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Acciones Rápidas</h3>
        <div class="flex flex-col gap-2">
          <a href="/admin/trabajos?new=true" class="flex items-center gap-3 p-2.5 rounded-lg hover:bg-gray-50 transition-colors border border-gray-100 group">
            <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-[#1E3A5F]">Nuevo Trabajo</p>
            </div>
          </a>
          <a href="/admin/clientes?new=true" class="flex items-center gap-3 p-2.5 rounded-lg hover:bg-gray-50 transition-colors border border-gray-100 group">
            <div class="w-8 h-8 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-[#1E3A5F]">Nuevo Cliente</p>
            </div>
          </a>
          <a href="/admin/vehiculos?new=true" class="flex items-center gap-3 p-2.5 rounded-lg hover:bg-gray-50 transition-colors border border-gray-100 group">
            <div class="w-8 h-8 rounded-lg bg-accent/10 text-accent flex items-center justify-center group-hover:bg-accent group-hover:text-white transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-[#1E3A5F]">Nuevo Vehículo</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Últimos clientes -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
          <h2 class="text-lg font-bold text-[#1E3A5F]">Últimos Clientes</h2>
          <a href="/admin/clientes" class="text-xs font-semibold text-secondary hover:text-secondary/80">Ver todos</a>
        </div>
        <div class="p-2" id="tb-clientes">
          <p class="text-center text-xs text-gray-500 py-3">Cargando clientes...</p>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL || 'https://zsddtosxnfqmbyxptkfs.supabase.co',
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpzZGR0b3N4bmZxbWJ5eHB0a2ZzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2NTc5MjEsImV4cCI6MjEwNDIzMzkyMX0.x7Oysn4OW3p5_Lwaj87vjdKOWvRyfeXKuQhGsO7XjGw'
  );

  const formatDate = (dateStr) => {
    if (!dateStr) return '';
    const [year, month, day] = dateStr.split('T')[0].split('-');
    return `${day}/${month}/${year}`;
  };

  async function loadDashboardData() {
    try {
      // Counts
      const { count: countClientes } = await supabase.from('clientes').select('*', { count: 'exact', head: true });
      const { count: countVehiculos } = await supabase.from('vehiculos').select('*', { count: 'exact', head: true });
      
      const date = new Date();
      const firstDay = new Date(date.getFullYear(), date.getMonth(), 1).toISOString();
      const { count: countTrabajos } = await supabase.from('trabajos').select('*', { count: 'exact', head: true }).gte('fecha_ingreso', firstDay);

      document.getElementById('stat-clientes').textContent = countClientes || '0';
      document.getElementById('stat-vehiculos').textContent = countVehiculos || '0';
      document.getElementById('stat-trabajos').textContent = countTrabajos || '0';

      // Ultimos trabajos
      const { data: trabajos } = await supabase
        .from('trabajos')
        .select('*, tipos_trabajo(nombre), vehiculos(marca, modelo, id_cliente, clientes(nombre, apellido))')
        .order('fecha_ingreso', { ascending: false })
        .limit(5);

      const tbTrabajos = document.getElementById('tb-trabajos');
      if (trabajos && trabajos.length > 0) {
        tbTrabajos.innerHTML = trabajos.map(t => {
          const estadoReal = t.estado === 'Entregado' || t.fecha_entrega ? 'Entregado' : (t.estado || 'En proceso');
          let badge = '';
          switch(estadoReal) {
            case 'En proceso': badge = '<span class="px-2 py-0.5 bg-yellow-100 text-yellow-800 rounded text-[11px] font-medium">En proceso</span>'; break;
            case 'Terminado': badge = '<span class="px-2 py-0.5 bg-green-100 text-green-800 rounded text-[11px] font-medium">Terminado</span>'; break;
            case 'Entregado': badge = '<span class="px-2 py-0.5 bg-green-100 text-green-800 rounded text-[11px] font-medium">Entregado</span>'; break;
            default: badge = `<span class="px-2 py-0.5 bg-gray-100 text-gray-800 rounded text-[11px] font-medium">${estadoReal}</span>`;
          }
          let tipoNombre = t.tipos_trabajo?.nombre;
          if (!tipoNombre || tipoNombre === 'Otro') {
            const desc = t.descripcion || 'Otro';
            tipoNombre = desc.length > 25 ? desc.substring(0, 25) + '...' : desc;
          }

          return `
            <tr class="hover:bg-gray-50 cursor-pointer transition-colors" onclick="window.location.href='/admin/trabajos?view=${t.id_trabajo}'">
              <td class="px-4 py-3 font-medium text-xs text-gray-900">${formatDate(t.fecha_ingreso)}</td>
              <td class="px-4 py-3">
                <p class="font-bold text-[#1E3A5F] text-sm">${t.vehiculos?.marca || ''} ${t.vehiculos?.modelo || ''}</p>
                <p class="text-[11px] text-gray-500">${t.vehiculos?.clientes?.nombre || ''} ${t.vehiculos?.clientes?.apellido || ''}</p>
              </td>
              <td class="px-4 py-3 text-xs text-gray-700">${tipoNombre}</td>
              <td class="px-4 py-3 text-center">${badge}</td>
            </tr>
          `;
        }).join('');
      } else {
        tbTrabajos.innerHTML = '<tr><td colspan="4" class="px-4 py-6 text-center text-gray-500 text-sm">No hay trabajos registrados.</td></tr>';
      }

      // Ultimos clientes
      const { data: clientes } = await supabase.from('clientes').select('*').order('id_cliente', { ascending: false }).limit(5);
      const tbClientes = document.getElementById('tb-clientes');
      if (clientes && clientes.length > 0) {
        tbClientes.innerHTML = clientes.map(c => `
          <a href="/admin/clientes/detalle?id=${c.id_cliente}" class="flex items-center gap-3 p-2 hover:bg-gray-50 rounded-lg transition-colors group">
            <div class="w-8 h-8 rounded-full bg-[#1E3A5F]/10 text-[#1E3A5F] flex items-center justify-center font-bold text-xs">
              ${c.nombre.charAt(0)}${c.apellido.charAt(0)}
            </div>
            <div>
              <p class="text-sm font-bold text-[#1E3A5F] group-hover:text-secondary transition-colors">${c.nombre} ${c.apellido}</p>
              <p class="text-xs text-gray-500">${c.telefono || 'Sin teléfono'}</p>
            </div>
          </a>
        `).join('');
      } else {
        tbClientes.innerHTML = '<p class="text-center text-sm text-gray-500 py-4">No hay clientes registrados.</p>';
      }

    } catch (err) {
      console.error('Error cargando dashboard', err);
    }
  }

  // Ejecutar script inmediatamente 
  loadDashboardData();
</script>
