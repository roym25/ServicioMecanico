---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard" subtitle="Resumen operativo del taller mecánico">
  <!-- Loading State -->
  <div id="loading-state" class="py-16 flex flex-col items-center justify-center space-y-4">
    <div class="w-12 h-12 border-4 border-primary/20 border-t-secondary rounded-full animate-spin"></div>
    <p class="text-sm font-medium text-gray-500 animate-pulse">Cargando datos del taller...</p>
  </div>

  <!-- Error Alert (hidden by default) -->
  <div id="error-alert" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm">
    <div class="flex items-center gap-2 font-semibold mb-1">
      <span>⚠️</span>
      <span>Error al conectar con la base de datos</span>
    </div>
    <p id="error-message" class="text-xs text-red-600"></p>
  </div>

  <!-- Dashboard Content (hidden while loading) -->
  <div id="dashboard-content" class="hidden space-y-8">
    <!-- Quick Actions Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
      <div>
        <h2 class="text-lg font-bold text-primary">Acciones Rápidas</h2>
        <p class="text-xs text-gray-500">Accede directamente al registro de nuevos registros en el sistema</p>
      </div>
      <div class="flex flex-wrap gap-2.5">
        <a
          href="/admin/clientes"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-primary text-white hover:bg-primary/90 transition shadow-sm"
        >
          <span>👥</span> + Nuevo Cliente
        </a>
        <a
          href="/admin/vehiculos"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-primary text-white hover:bg-primary/90 transition shadow-sm"
        >
          <span>🚗</span> + Nuevo Vehículo
        </a>
        <a
          href="/admin/trabajos"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-secondary text-white hover:bg-secondary/90 transition shadow-sm"
        >
          <span>📋</span> + Nuevo Trabajo
        </a>
      </div>
    </div>

    <!-- 3 Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Stat 1: Total Clientes -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Total Clientes</p>
            <h3 id="stat-clientes" class="text-4xl font-extrabold text-primary">—</h3>
          </div>
          <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center text-3xl shrink-0">
            👥
          </div>
        </div>
        <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between text-xs">
          <span class="text-gray-500">Registrados en el sistema</span>
          <a href="/admin/clientes" class="text-secondary font-bold hover:underline">Ver clientes →</a>
        </div>
      </div>

      <!-- Stat 2: Total Vehículos -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Total Vehículos</p>
            <h3 id="stat-vehiculos" class="text-4xl font-extrabold text-primary">—</h3>
          </div>
          <div class="w-14 h-14 rounded-2xl bg-[#2D6A4F]/10 flex items-center justify-center text-3xl shrink-0">
            🚗
          </div>
        </div>
        <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between text-xs">
          <span class="text-gray-500">En flota del taller</span>
          <a href="/admin/vehiculos" class="text-secondary font-bold hover:underline">Ver vehículos →</a>
        </div>
      </div>

      <!-- Stat 3: Trabajos este mes -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Trabajos este mes</p>
            <h3 id="stat-trabajos-mes" class="text-4xl font-extrabold text-primary">—</h3>
          </div>
          <div class="w-14 h-14 rounded-2xl bg-secondary/10 flex items-center justify-center text-3xl shrink-0">
            📋
          </div>
        </div>
        <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between text-xs">
          <span id="mes-nombre" class="text-gray-500">Mes en curso</span>
          <a href="/admin/trabajos" class="text-secondary font-bold hover:underline">Ver historial →</a>
        </div>
      </div>
    </div>

    <!-- Main Grid: Últimos Trabajos (2 cols on lg) and Últimos Clientes (1 col on lg) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Section: Últimos Trabajos -->
      <div class="lg:col-span-2 bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <div class="flex items-center justify-between pb-4 border-b border-gray-100 mb-4">
          <div>
            <h2 class="text-lg font-bold text-primary flex items-center gap-2">
              <span>🔧</span>
              <span>Últimos Trabajos</span>
            </h2>
            <p class="text-xs text-gray-500">Últimos 5 servicios registrados en el taller</p>
          </div>
          <a
            href="/admin/trabajos"
            class="text-xs font-bold text-secondary hover:text-secondary/80 flex items-center gap-1 transition"
          >
            <span>Ver todos</span>
            <span>→</span>
          </a>
        </div>

        <!-- Responsive Table Container -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-gray-50/80 text-xs font-bold uppercase tracking-wider text-gray-500 border-b border-gray-100">
              <tr>
                <th class="py-3 px-3.5">Fecha</th>
                <th class="py-3 px-3.5">Vehículo</th>
                <th class="py-3 px-3.5">Descripción</th>
                <th class="py-3 px-3.5">Costo</th>
                <th class="py-3 px-3.5 text-center">Estado</th>
              </tr>
            </thead>
            <tbody id="ultimos-trabajos-tbody" class="divide-y divide-gray-100">
              <!-- Dynamically populated -->
            </tbody>
          </table>
          <div id="no-trabajos-msg" class="hidden py-10 text-center text-sm text-gray-400">
            No se han registrado trabajos recientemente.
          </div>
        </div>
      </div>

      <!-- Section: Últimos Clientes -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <div class="flex items-center justify-between pb-4 border-b border-gray-100 mb-4">
          <div>
            <h2 class="text-lg font-bold text-primary flex items-center gap-2">
              <span>👥</span>
              <span>Últimos Clientes</span>
            </h2>
            <p class="text-xs text-gray-500">5 clientes más recientes</p>
          </div>
          <a
            href="/admin/clientes"
            class="text-xs font-bold text-secondary hover:text-secondary/80 flex items-center gap-1 transition"
          >
            <span>Ver todos</span>
            <span>→</span>
          </a>
        </div>

        <!-- List -->
        <div id="ultimos-clientes-list" class="divide-y divide-gray-100">
          <!-- Dynamically populated -->
        </div>
        <div id="no-clientes-msg" class="hidden py-10 text-center text-sm text-gray-400">
          No hay clientes registrados aún.
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    'https://zsddtosxnfqmbyxptkfs.supabase.co',
    'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpzZGR0b3N4bmZxbWJ5eHB0a2ZzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2NTc5MjEsImV4cCI6MjEwNDIzMzkyMX0.x7Oysn4OW3p5_Lwaj87vjdKOWvRyfeXKuQhGsO7XjGw'
  );

  function formatDate(dateStr: string | null | undefined): string {
    if (!dateStr) return '—';
    const parts = dateStr.split('T')[0].split('-');
    if (parts.length === 3) {
      return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const year = d.getFullYear();
    return `${day}/${month}/${year}`;
  }

  function formatCurrency(amount: number | string | null | undefined): string {
    const num = parseFloat(String(amount ?? 0)) || 0;
    return new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(num);
  }

  async function loadDashboardData() {
    const loadingEl = document.getElementById('loading-state');
    const contentEl = document.getElementById('dashboard-content');
    const errorAlert = document.getElementById('error-alert');
    const errorMsg = document.getElementById('error-message');

    try {
      // Set current month name
      const meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
      const now = new Date();
      const mesNombreEl = document.getElementById('mes-nombre');
      if (mesNombreEl) {
        mesNombreEl.textContent = `${meses[now.getMonth()]} ${now.getFullYear()}`;
      }

      // Calculate start of current month (YYYY-MM-01)
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const startOfMonth = `${year}-${month}-01`;

      // Parallel data fetching for high performance
      const [clientesRes, vehiculosRes, trabajosMesRes, ultimosTrabajosRes, ultimosClientesRes] = await Promise.all([
        supabase.from('clientes').select('*', { count: 'exact', head: true }),
        supabase.from('vehiculos').select('*', { count: 'exact', head: true }),
        supabase.from('trabajos').select('*', { count: 'exact', head: true }).gte('fecha_ingreso', startOfMonth),
        supabase.from('trabajos').select('*, vehiculos(marca, modelo)').order('id_trabajo', { ascending: false }).limit(5),
        supabase.from('clientes').select('*').order('id_cliente', { ascending: false }).limit(5),
      ]);

      // Handle Stat 1: Total Clientes
      const statClientesEl = document.getElementById('stat-clientes');
      if (statClientesEl) {
        statClientesEl.textContent = String(clientesRes.count ?? 0);
      }

      // Handle Stat 2: Total Vehículos
      const statVehiculosEl = document.getElementById('stat-vehiculos');
      if (statVehiculosEl) {
        statVehiculosEl.textContent = String(vehiculosRes.count ?? 0);
      }

      // Handle Stat 3: Trabajos este mes
      const statTrabajosMesEl = document.getElementById('stat-trabajos-mes');
      if (statTrabajosMesEl) {
        statTrabajosMesEl.textContent = String(trabajosMesRes.count ?? 0);
      }

      // Render Últimos Trabajos
      const tbody = document.getElementById('ultimos-trabajos-tbody');
      const noTrabajosMsg = document.getElementById('no-trabajos-msg');
      if (tbody) {
        tbody.innerHTML = '';
        const trabajos = ultimosTrabajosRes.data || [];
        if (trabajos.length === 0) {
          noTrabajosMsg?.classList.remove('hidden');
        } else {
          noTrabajosMsg?.classList.add('hidden');
          trabajos.forEach((trabajo: any) => {
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-gray-50/80 transition-colors';

            const fechaDisplay = formatDate(trabajo.fecha_ingreso || trabajo.fecha_registro);
            const vehiculoDisplay = trabajo.vehiculos
              ? `${trabajo.vehiculos.marca || ''} ${trabajo.vehiculos.modelo || ''}`.trim() || 'Vehículo s/d'
              : 'Vehículo s/d';
            const descripcionDisplay = trabajo.descripcion || 'Sin descripción';
            const costoDisplay = formatCurrency(trabajo.costo);

            const isEntregado = Boolean(trabajo.fecha_entrega);
            const estadoBadge = isEntregado
              ? `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-[#2D6A4F]/15 text-[#2D6A4F] border border-[#2D6A4F]/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#2D6A4F]"></span> Entregado
                 </span>`
              : `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-[#F4A261]/20 text-[#B75D14] border border-[#F4A261]/40">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#F4A261] animate-pulse"></span> En proceso
                 </span>`;

            tr.innerHTML = `
              <td class="py-3.5 px-3.5 text-xs text-gray-600 whitespace-nowrap">${fechaDisplay}</td>
              <td class="py-3.5 px-3.5 font-bold text-primary whitespace-nowrap">${vehiculoDisplay}</td>
              <td class="py-3.5 px-3.5 text-xs text-gray-700 max-w-[200px] truncate" title="${descripcionDisplay}">${descripcionDisplay}</td>
              <td class="py-3.5 px-3.5 text-xs font-semibold text-gray-900 whitespace-nowrap">${costoDisplay}</td>
              <td class="py-3.5 px-3.5 text-center whitespace-nowrap">${estadoBadge}</td>
            `;
            tbody.appendChild(tr);
          });
        }
      }

      // Render Últimos Clientes
      const clientesList = document.getElementById('ultimos-clientes-list');
      const noClientesMsg = document.getElementById('no-clientes-msg');
      if (clientesList) {
        clientesList.innerHTML = '';
        const clientes = ultimosClientesRes.data || [];
        if (clientes.length === 0) {
          noClientesMsg?.classList.remove('hidden');
        } else {
          noClientesMsg?.classList.add('hidden');
          clientes.forEach((cliente: any) => {
            const item = document.createElement('div');
            item.className = 'py-3.5 flex items-center justify-between gap-3 hover:bg-gray-50/80 px-2 rounded-xl transition-colors';

            const nombreCompleto = `${cliente.nombre || ''} ${cliente.apellido || ''}`.trim() || 'Cliente';
            const iniciales = `${(cliente.nombre || 'C')[0]}${(cliente.apellido || '')[0] || ''}`.toUpperCase();
            const telefono = cliente.telefono || 'Sin teléfono';

            item.innerHTML = `
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-9 h-9 rounded-full bg-primary/10 text-primary font-bold text-xs flex items-center justify-center shrink-0 border border-primary/20">
                  ${iniciales}
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-bold text-gray-900 truncate">${nombreCompleto}</p>
                  <p class="text-xs text-gray-500 flex items-center gap-1">
                    <span>📞</span>
                    <span>${telefono}</span>
                  </p>
                </div>
              </div>
              <a href="/admin/clientes" class="text-xs font-medium text-primary hover:text-secondary px-2 py-1 rounded bg-gray-100 hover:bg-gray-200 transition shrink-0">
                Ver
              </a>
            `;
            clientesList.appendChild(item);
          });
        }
      }

      // Show content
      loadingEl?.classList.add('hidden');
      contentEl?.classList.remove('hidden');
    } catch (err: any) {
      console.error('Error cargando datos del dashboard:', err);
      loadingEl?.classList.add('hidden');
      if (errorAlert && errorMsg) {
        errorAlert.classList.remove('hidden');
        errorMsg.textContent = err.message || 'No se pudo conectar a la base de datos de Supabase.';
      }
    }
  }

  // Run on page load
  document.addEventListener('DOMContentLoaded', loadDashboardData);
  // Fallback for Astro page transitions or already-loaded DOM
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    loadDashboardData();
  }
</script>
