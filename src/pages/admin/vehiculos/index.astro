---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Vehículos" subtitle="Control y registro de vehículos de clientes del taller">
  <!-- Toast Notification -->
  <div
    id="toast"
    class="fixed bottom-5 right-5 z-50 hidden max-w-sm w-full p-4 rounded-xl shadow-2xl text-sm font-medium transition-all duration-300 transform translate-y-4 opacity-0 flex items-center justify-between gap-3 border"
    role="status"
    aria-live="polite"
  >
    <div class="flex items-center gap-2.5">
      <span id="toast-icon" class="text-xl">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      </span>
      <span id="toast-message" class="text-xs sm:text-sm">Operación realizada con éxito</span>
    </div>
    <button id="toast-close" type="button" class="text-gray-400 hover:text-gray-700 p-1">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>

  <div class="space-y-6">
    <!-- Top Action Bar -->
    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
      <!-- Search input -->
      <div class="relative flex-1 max-w-md">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </span>
        <input
          type="text"
          id="search-input"
          placeholder="Buscar por marca, modelo, año, serie o dueño..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
        />
      </div>

      <!-- New Vehicle Button & Count Badge -->
      <div class="flex items-center gap-3">
        <span id="vehiculo-count-badge" class="text-xs font-semibold text-gray-500 bg-gray-100 px-3 py-1.5 rounded-lg">
          0 vehículos
        </span>
        <button
          type="button"
          id="btn-open-create-modal"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold bg-secondary hover:bg-secondary/90 text-white shadow-sm hover:shadow transition transform active:scale-95 shrink-0"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          <span>Nuevo Vehículo</span>
        </button>
      </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <!-- Loading state -->
      <div id="table-loading" class="py-16 flex flex-col items-center justify-center space-y-3">
        <div class="w-10 h-10 border-4 border-primary/20 border-t-secondary rounded-full animate-spin"></div>
        <p class="text-sm font-medium text-gray-500">Cargando flota de vehículos...</p>
      </div>

      <!-- Responsive Table -->
      <div id="table-container" class="hidden overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-gray-50 text-xs font-bold uppercase tracking-wider text-gray-500 border-b border-gray-100">
            <tr>
              <th class="py-3.5 px-4">Marca</th>
              <th class="py-3.5 px-4">Modelo</th>
              <th class="py-3.5 px-4">Año</th>
              <th class="py-3.5 px-4">Kilometraje</th>
              <th class="py-3.5 px-4">Num. Serie (VIN)</th>
              <th class="py-3.5 px-4">Dueño</th>
              <th class="py-3.5 px-4 text-center">Acciones</th>
            </tr>
          </thead>
          <tbody id="vehiculos-table-body" class="divide-y divide-gray-100">
            <!-- Populated dynamically -->
          </tbody>
        </table>

        <!-- Empty state -->
        <div id="empty-state" class="hidden py-16 text-center">
          <div class="w-16 h-16 mx-auto mb-3 rounded-full bg-gray-100 flex items-center justify-center text-gray-400">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm14 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
          </div>
          <h3 class="text-base font-bold text-gray-800">No se encontraron vehículos</h3>
          <p class="text-xs text-gray-500 mt-1 max-w-sm mx-auto">
            No hay vehículos que coincidan con la búsqueda o aún no se han registrado unidades en el sistema.
          </p>
          <button
            type="button"
            id="empty-btn-create"
            class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-secondary text-white hover:bg-secondary/90 transition shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Registrar Nuevo Vehículo
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Create / Edit Vehicle -->
  <div
    id="vehiculo-modal"
    class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <div class="bg-white rounded-2xl max-w-lg w-full shadow-2xl border border-gray-100 overflow-hidden my-8">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
        <div>
          <h3 id="modal-title" class="text-lg font-bold text-primary">Nuevo Vehículo</h3>
          <p class="text-xs text-gray-500">Asocia el vehículo a un cliente registrado</p>
        </div>
        <button
          type="button"
          id="btn-close-modal"
          class="text-gray-400 hover:text-gray-600 p-1.5 rounded-lg hover:bg-gray-100 transition"
          aria-label="Cerrar modal"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Modal Form -->
      <form id="vehiculo-form" class="p-6 space-y-4">
        <input type="hidden" id="form-vehiculo-id" value="" />

        <!-- Dueño (Dropdown Select) -->
        <div>
          <label for="form-id-cliente" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
            Dueño del Vehículo (Cliente) <span class="text-secondary">*</span>
          </label>
          <div class="flex gap-2">
            <select
              id="form-id-cliente"
              required
              class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition bg-white"
            >
              <option value="" disabled selected>Selecciona un cliente...</option>
              <!-- Options populated dynamically -->
            </select>
            <a
              href="/admin/clientes"
              target="_blank"
              class="px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-xs font-bold flex items-center justify-center shrink-0 transition"
              title="Ir a registrar cliente nuevo"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Marca -->
          <div>
            <label for="form-marca" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Marca <span class="text-secondary">*</span>
            </label>
            <select
              id="form-marca"
              required
              class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition bg-white"
            >
              <option value="" disabled selected>Selecciona marca...</option>
              <!-- Options populated dynamically -->
            </select>
          </div>

          <!-- Modelo -->
          <div>
            <label for="form-modelo" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Modelo <span class="text-secondary">*</span>
            </label>
            <input
              type="text"
              id="form-modelo"
              required
              placeholder="Ej. Sentra, Corolla, Ranger"
              class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Año -->
          <div>
            <label for="form-anio" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Año <span class="text-secondary">*</span>
            </label>
            <input
              type="number"
              id="form-anio"
              required
              min="1950"
              max="2035"
              placeholder="Ej. 2020"
              class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
            />
          </div>

          <!-- Km -->
          <div>
            <label for="form-km" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Kilometraje Actual <span class="text-secondary">*</span>
            </label>
            <input
              type="number"
              id="form-km"
              required
              min="0"
              placeholder="Ej. 75000"
              class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
            />
          </div>
        </div>

        <!-- Número de Serie -->
        <div>
          <label for="form-numserie" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
            Número de Serie (VIN)
          </label>
          <input
            type="text"
            id="form-numserie"
            placeholder="Opcional"
            class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-sm uppercase focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition font-mono"
          />
        </div>

        <!-- Modal Footer Buttons -->
        <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
          <button
            type="button"
            id="btn-cancel-modal"
            class="px-4 py-2.5 rounded-xl text-sm font-semibold text-gray-600 hover:bg-gray-100 transition"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="btn-submit-form"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold bg-primary hover:bg-primary/90 text-white shadow-sm transition transform active:scale-95"
          >
            <span id="btn-submit-text">Guardar Vehículo</span>
            <span id="btn-submit-spinner" class="hidden w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    'https://zsddtosxnfqmbyxptkfs.supabase.co',
    'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpzZGR0b3N4bmZxbWJ5eHB0a2ZzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2NTc5MjEsImV4cCI6MjEwNDIzMzkyMX0.x7Oysn4OW3p5_Lwaj87vjdKOWvRyfeXKuQhGsO7XjGw'
  );

  interface ClienteRef {
    id_cliente: number;
    nombre: string;
    apellido: string;
  }

  interface MarcaRef {
    id_marca: number;
    nombre: string;
  }

  interface Vehiculo {
    id_vehiculo: number;
    id_cliente: number;
    marca: string;
    modelo: string;
    anio: number;
    km: number;
    numserie?: string | null;
    fecha_registro?: string;
    clientes?: {
      nombre: string;
      apellido: string;
    } | null;
  }

  let vehiculosList: Vehiculo[] = [];
  let clientesOptions: ClienteRef[] = [];
  let marcasOptions: MarcaRef[] = [];
  let toastTimer: any = null;

  // DOM Elements
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const vehiculoCountBadge = document.getElementById('vehiculo-count-badge');
  const tableLoading = document.getElementById('table-loading');
  const tableContainer = document.getElementById('table-container');
  const tableBody = document.getElementById('vehiculos-table-body');
  const emptyState = document.getElementById('empty-state');
  const modal = document.getElementById('vehiculo-modal');
  const modalTitle = document.getElementById('modal-title');
  const vehiculoForm = document.getElementById('vehiculo-form') as HTMLFormElement;
  const formVehiculoId = document.getElementById('form-vehiculo-id') as HTMLInputElement;
  const formIdCliente = document.getElementById('form-id-cliente') as HTMLSelectElement;
  const formMarca = document.getElementById('form-marca') as HTMLSelectElement;
  const formModelo = document.getElementById('form-modelo') as HTMLInputElement;
  const formAnio = document.getElementById('form-anio') as HTMLInputElement;
  const formKm = document.getElementById('form-km') as HTMLInputElement;
  const formNumserie = document.getElementById('form-numserie') as HTMLInputElement;
  const btnSubmitText = document.getElementById('btn-submit-text');
  const btnSubmitSpinner = document.getElementById('btn-submit-spinner');
  const btnSubmitForm = document.getElementById('btn-submit-form') as HTMLButtonElement;

  function showToast(message: string, isSuccess = true) {
    const toast = document.getElementById('toast');
    const toastIcon = document.getElementById('toast-icon');
    const toastMessage = document.getElementById('toast-message');

    if (!toast || !toastIcon || !toastMessage) return;
    if (toastTimer) clearTimeout(toastTimer);

    toastMessage.textContent = message;
    if (isSuccess) {
      toastIcon.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
      toast.className =
        'fixed bottom-5 right-5 z-50 max-w-sm w-full p-4 rounded-xl shadow-2xl text-sm font-medium transition-all duration-300 transform translate-y-0 opacity-100 flex items-center justify-between gap-3 bg-[#2D6A4F] text-white border-green-700';
    } else {
      toastIcon.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>';
      toast.className =
        'fixed bottom-5 right-5 z-50 max-w-sm w-full p-4 rounded-xl shadow-2xl text-sm font-medium transition-all duration-300 transform translate-y-0 opacity-100 flex items-center justify-between gap-3 bg-[#E63946] text-white border-red-700';
    }

    toastTimer = setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-4');
      setTimeout(() => toast.classList.add('hidden'), 300);
    }, 4000);
  }

  const toastClose = document.getElementById('toast-close');
  if (toastClose) {
    toastClose.addEventListener('click', () => {
      const toast = document.getElementById('toast');
      if (toast) {
        toast.classList.add('opacity-0', 'translate-y-4');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }
    });
  }

  function formatKm(km: number | string | null | undefined): string {
    const n = parseInt(String(km ?? 0), 10);
    if (isNaN(n)) return '0 km';
    return `${n.toLocaleString('es-MX')} km`;
  }

  async function loadClientesForSelect() {
    try {
      const { data, error } = await supabase
        .from('clientes')
        .select('id_cliente, nombre, apellido')
        .order('nombre', { ascending: true });

      if (error) throw error;
      clientesOptions = data || [];
      populateClienteDropdown();
    } catch (err) {
      console.error('Error cargando clientes para el select:', err);
    }
  }

  async function loadMarcasForSelect() {
    try {
      const { data, error } = await supabase
        .from('marcas_vehiculo')
        .select('id_marca, nombre')
        .eq('activo', true)
        .order('nombre', { ascending: true });

      if (error) throw error;
      marcasOptions = data || [];
      populateMarcaDropdown();
    } catch (err) {
      console.error('Error cargando marcas para el select:', err);
    }
  }

  function populateClienteDropdown(selectedId?: number) {
    if (!formIdCliente) return;
    formIdCliente.innerHTML = '<option value="" disabled>Selecciona un cliente...</option>';

    if (clientesOptions.length === 0) {
      const opt = document.createElement('option');
      opt.disabled = true;
      opt.textContent = 'No hay clientes registrados';
      formIdCliente.appendChild(opt);
      return;
    }

    clientesOptions.forEach((cliente) => {
      const opt = document.createElement('option');
      opt.value = String(cliente.id_cliente);
      opt.textContent = `${cliente.nombre} ${cliente.apellido}`.trim();
      if (selectedId && cliente.id_cliente === selectedId) {
        opt.selected = true;
      }
      formIdCliente.appendChild(opt);
    });

    if (!selectedId) {
      formIdCliente.selectedIndex = 0;
    }
  }

  function populateMarcaDropdown(selectedMarcaName?: string) {
    if (!formMarca) return;
    formMarca.innerHTML = '<option value="" disabled>Selecciona marca...</option>';

    marcasOptions.forEach((marca) => {
      const opt = document.createElement('option');
      opt.value = marca.nombre; // We store the name in vehiculos table
      opt.textContent = marca.nombre;
      if (selectedMarcaName && marca.nombre === selectedMarcaName) {
        opt.selected = true;
      }
      formMarca.appendChild(opt);
    });

    if (!selectedMarcaName) {
      formMarca.selectedIndex = 0;
    }
  }

  function openCreateModal() {
    if (!modal) return;
    vehiculoForm.reset();
    formVehiculoId.value = '';
    populateClienteDropdown();
    populateMarcaDropdown();
    if (modalTitle) modalTitle.textContent = 'Nuevo Vehículo';
    if (btnSubmitText) btnSubmitText.textContent = 'Guardar Vehículo';
    modal.classList.remove('hidden');
    formMarca.focus();
  }

  function openEditModal(v: Vehiculo) {
    if (!modal) return;
    vehiculoForm.reset();
    formVehiculoId.value = String(v.id_vehiculo);
    populateClienteDropdown(v.id_cliente);
    populateMarcaDropdown(v.marca);
    
    formModelo.value = v.modelo || '';
    formAnio.value = v.anio ? String(v.anio) : '';
    formKm.value = v.km !== undefined && v.km !== null ? String(v.km) : '';
    formNumserie.value = v.numserie || '';

    if (modalTitle) modalTitle.textContent = 'Editar Vehículo';
    if (btnSubmitText) btnSubmitText.textContent = 'Actualizar Cambios';
    modal.classList.remove('hidden');
    formMarca.focus();
  }

  function closeModal() {
    if (modal) modal.classList.add('hidden');
    vehiculoForm.reset();
  }

  function renderTable(vehiculos: Vehiculo[]) {
    if (!tableBody || !emptyState || !vehiculoCountBadge) return;

    tableBody.innerHTML = '';
    vehiculoCountBadge.textContent = `${vehiculos.length} ${vehiculos.length === 1 ? 'vehículo' : 'vehículos'}`;

    if (vehiculos.length === 0) {
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');

    vehiculos.forEach((v) => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-gray-50/80 transition-colors group cursor-pointer';

      tr.addEventListener('click', () => {
        window.location.href = `/admin/vehiculos/detalle?id=${v.id_vehiculo}`;
      });

      const marca = v.marca || '—';
      const modelo = v.modelo || '—';
      const anio = v.anio ? String(v.anio) : '—';
      const kmFormatted = formatKm(v.km);
      const numserie = v.numserie || '—';
      const duenio = v.clientes ? `${v.clientes.nombre} ${v.clientes.apellido}`.trim() : 'Sin dueño asignado';

      tr.innerHTML = `
        <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">${marca}</td>
        <td class="py-3.5 px-4 font-semibold text-primary whitespace-nowrap">${modelo}</td>
        <td class="py-3.5 px-4 text-gray-700 whitespace-nowrap">${anio}</td>
        <td class="py-3.5 px-4 text-gray-700 whitespace-nowrap">${kmFormatted}</td>
        <td class="py-3.5 px-4 text-xs font-mono text-gray-500 whitespace-nowrap">${numserie}</td>
        <td class="py-3.5 px-4 whitespace-nowrap">
          <span class="inline-flex items-center gap-1.5 font-medium text-gray-800">
            <span class="w-6 h-6 rounded-full bg-primary/10 text-primary text-[10px] font-bold flex items-center justify-center">
              ${duenio[0] || 'C'}
            </span>
            <span>${duenio}</span>
          </span>
        </td>
        <td class="py-3.5 px-4 text-center whitespace-nowrap">
          <div class="inline-flex items-center gap-1.5" onclick="event.stopPropagation()">
            <a
              href="/admin/vehiculos/detalle?id=${v.id_vehiculo}"
              class="p-1.5 rounded-lg text-gray-500 hover:text-primary hover:bg-primary/10 transition"
              title="Ver detalle"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
            </a>
            <button
              type="button"
              class="btn-edit p-1.5 rounded-lg text-gray-500 hover:text-primary hover:bg-primary/10 transition"
              title="Editar vehículo"
              data-id="${v.id_vehiculo}"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
            </button>
            <button
              type="button"
              class="btn-delete p-1.5 rounded-lg text-gray-500 hover:text-secondary hover:bg-secondary/10 transition"
              title="Eliminar vehículo"
              data-id="${v.id_vehiculo}"
              data-desc="${marca} ${modelo}"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
          </div>
        </td>
      `;

      const editBtn = tr.querySelector('.btn-edit');
      editBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        openEditModal(v);
      });

      const deleteBtn = tr.querySelector('.btn-delete');
      deleteBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        deleteVehiculo(v.id_vehiculo, `${marca} ${modelo}`);
      });

      tableBody.appendChild(tr);
    });
  }

  function filterVehiculos() {
    const term = (searchInput?.value || '').toLowerCase().trim();
    if (!term) {
      renderTable(vehiculosList);
      return;
    }

    const filtered = vehiculosList.filter((v) => {
      const marca = (v.marca || '').toLowerCase();
      const modelo = (v.modelo || '').toLowerCase();
      const anio = String(v.anio || '').toLowerCase();
      const km = String(v.km || '').toLowerCase();
      const numserie = (v.numserie || '').toLowerCase();
      const duenio = v.clientes ? `${v.clientes.nombre} ${v.clientes.apellido}`.toLowerCase() : '';

      return (
        marca.includes(term) ||
        modelo.includes(term) ||
        `${marca} ${modelo}`.includes(term) ||
        anio.includes(term) ||
        km.includes(term) ||
        numserie.includes(term) ||
        duenio.includes(term)
      );
    });

    renderTable(filtered);
  }

  async function loadVehiculos() {
    try {
      tableLoading?.classList.remove('hidden');
      tableContainer?.classList.add('hidden');

      const { data, error } = await supabase
        .from('vehiculos')
        .select('*, clientes(nombre, apellido)')
        .order('id_vehiculo', { ascending: false });

      if (error) throw error;

      vehiculosList = data || [];
      filterVehiculos();
    } catch (err: any) {
      console.error('Error cargando vehículos:', err);
      showToast(err.message || 'Error al cargar vehículos', false);
    } finally {
      tableLoading?.classList.add('hidden');
      tableContainer?.classList.remove('hidden');
    }
  }

  async function handleFormSubmit(e: Event) {
    e.preventDefault();

    const idClienteStr = formIdCliente.value;
    const marca = formMarca.value.trim();
    const modelo = formModelo.value.trim();
    const anio = parseInt(formAnio.value, 10);
    const km = formKm.value ? parseInt(formKm.value, 10) : null;
    const numserie = formNumserie.value.trim().toUpperCase() || null;
    const id = formVehiculoId.value ? parseInt(formVehiculoId.value, 10) : null;

    if (!idClienteStr || !marca || !modelo || isNaN(anio) || km === null) {
      showToast('Por favor completa todos los campos requeridos', false);
      return;
    }

    if (numserie) {
      if (numserie.length !== 17) {
        showToast('El Número de Serie (VIN) debe tener exactamente 17 caracteres', 'error');
        return;
      }
      if (!/^[A-HJ-NPR-Z0-9]{17}$/.test(numserie)) {
        showToast('El VIN contiene caracteres inválidos (No puede contener I, O, Q)', 'error');
        return;
      }
    }

    const id_cliente = parseInt(idClienteStr, 10);

    btnSubmitSpinner?.classList.remove('hidden');
    btnSubmitForm.disabled = true;

    try {
      if (id) {
        // UPDATE
        const { error } = await supabase
          .from('vehiculos')
          .update({
            id_cliente,
            marca,
            modelo,
            anio,
            km,
            numserie,
          })
          .eq('id_vehiculo', id);

        if (error) throw error;
        showToast('Vehículo actualizado exitosamente');
      } else {
        // CREATE
        const { error } = await supabase.from('vehiculos').insert([
          {
            id_cliente,
            marca,
            modelo,
            anio,
            km,
            numserie,
          },
        ]);

        if (error) throw error;
        showToast('Vehículo registrado exitosamente');
      }

      closeModal();
      await loadVehiculos();
    } catch (err: any) {
      console.error('Error guardando vehículo:', err);
      showToast(err.message || 'Error al guardar el vehículo', false);
    } finally {
      btnSubmitSpinner?.classList.add('hidden');
      btnSubmitForm.disabled = false;
    }
  }

  async function deleteVehiculo(id: number, desc: string) {
    const ok = confirm(`¿Estás seguro de que deseas eliminar el vehículo "${desc}"?\n\nEsta acción eliminará también los trabajos asociados a este vehículo.`);
    if (!ok) return;

    try {
      const { error } = await supabase.from('vehiculos').delete().eq('id_vehiculo', id);
      if (error) throw error;

      showToast(`Vehículo "${desc}" eliminado correctamente`);
      await loadVehiculos();
    } catch (err: any) {
      console.error('Error eliminando vehículo:', err);
      showToast(err.message || 'No se pudo eliminar el vehículo', false);
    }
  }

  // Event Listeners
  document.getElementById('btn-open-create-modal')?.addEventListener('click', openCreateModal);
  document.getElementById('empty-btn-create')?.addEventListener('click', openCreateModal);
  document.getElementById('btn-close-modal')?.addEventListener('click', closeModal);
  document.getElementById('btn-cancel-modal')?.addEventListener('click', closeModal);
  vehiculoForm?.addEventListener('submit', handleFormSubmit);
  searchInput?.addEventListener('input', filterVehiculos);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Initial load
  Promise.all([
    loadClientesForSelect(),
    loadMarcasForSelect(),
    loadVehiculos()
  ]).then(() => {
    // Check if we need to auto-open the new or edit modal
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('new') === 'true') {
      const addBtn = document.getElementById('btn-open-create-modal');
      if (addBtn) addBtn.click();
      window.history.replaceState({}, document.title, window.location.pathname);
    } else if (urlParams.get('edit')) {
      const editId = parseInt(urlParams.get('edit'), 10);
      if (!isNaN(editId)) {
        const vehiculoToEdit = vehiculosList.find(v => v.id_vehiculo === editId);
        if (vehiculoToEdit) {
           openEditModal(vehiculoToEdit);
        }
      }
      window.history.replaceState({}, document.title, window.location.pathname);
    }
  });
</script>
