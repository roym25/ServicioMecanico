---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Catálogos">
  <div class="space-y-6">
    <!-- Tabs Header -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-2 flex space-x-2">
      <button onclick="switchTab('marcas')" id="tab-marcas" class="tab-btn active px-4 py-2 text-sm font-medium rounded-lg bg-primary/10 text-primary transition-colors">Marcas de Vehículos</button>
      <button onclick="switchTab('tipos')" id="tab-tipos" class="tab-btn px-4 py-2 text-sm font-medium rounded-lg text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-colors">Tipos de Trabajo</button>
      <button onclick="switchTab('viscosidades')" id="tab-viscosidades" class="tab-btn px-4 py-2 text-sm font-medium rounded-lg text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-colors">Viscosidades de Aceite</button>
    </div>

    <!-- Marcas de Vehículos Section -->
    <div id="section-marcas" class="tab-content block bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
        <div>
          <h2 class="text-xl font-bold text-[#1E3A5F]">Marcas de Vehículos</h2>
          <p class="text-sm text-gray-500 mt-1">Administra las marcas de vehículos disponibles.</p>
        </div>
        <button onclick="openModal('marcas')" class="bg-[#E63946] hover:bg-[#d63340] text-white px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Nueva Marca
        </button>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 text-gray-600 text-sm border-b border-gray-200">
              <th class="px-6 py-4 font-semibold">Nombre</th>
              <th class="px-6 py-4 font-semibold">Estado</th>
              <th class="px-6 py-4 font-semibold text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="marcas-tbody" class="divide-y divide-gray-100">
            <tr><td colspan="3" class="px-6 py-8 text-center text-gray-500">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tipos de Trabajo Section -->
    <div id="section-tipos" class="tab-content hidden bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
        <div>
          <h2 class="text-xl font-bold text-[#1E3A5F]">Tipos de Trabajo</h2>
          <p class="text-sm text-gray-500 mt-1">Gestiona los servicios y mantenimientos.</p>
        </div>
        <button onclick="openModal('tipos')" class="bg-[#E63946] hover:bg-[#d63340] text-white px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Nuevo Tipo
        </button>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 text-gray-600 text-sm border-b border-gray-200">
              <th class="px-6 py-4 font-semibold">Nombre</th>
              <th class="px-6 py-4 font-semibold">Descripción</th>
              <th class="px-6 py-4 font-semibold text-center">Campos Extra</th>
              <th class="px-6 py-4 font-semibold">Estado</th>
              <th class="px-6 py-4 font-semibold text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="tipos-tbody" class="divide-y divide-gray-100">
            <tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Viscosidades de Aceite Section -->
    <div id="section-viscosidades" class="tab-content hidden bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
        <div>
          <h2 class="text-xl font-bold text-[#1E3A5F]">Viscosidades de Aceite</h2>
          <p class="text-sm text-gray-500 mt-1">Controla los tipos de aceite para el taller.</p>
        </div>
        <button onclick="openModal('viscosidades')" class="bg-[#E63946] hover:bg-[#d63340] text-white px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Nueva Viscosidad
        </button>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 text-gray-600 text-sm border-b border-gray-200">
              <th class="px-6 py-4 font-semibold">Nombre</th>
              <th class="px-6 py-4 font-semibold">Estado</th>
              <th class="px-6 py-4 font-semibold text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="viscosidades-tbody" class="divide-y divide-gray-100">
            <tr><td colspan="3" class="px-6 py-8 text-center text-gray-500">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Shared Modal -->
  <div id="crud-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex justify-center items-center opacity-0 transition-opacity duration-200">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 transform scale-95 transition-transform duration-200" id="crud-modal-content">
      <div class="flex justify-between items-center p-6 border-b border-gray-100">
        <h3 id="modal-title" class="text-lg font-bold text-[#1E3A5F]">Nuevo Registro</h3>
        <button type="button" onclick="closeModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <form id="crud-form" class="p-6">
        <input type="hidden" id="form-entity" />
        <input type="hidden" id="form-id" />
        <div class="space-y-4">
          <div>
            <label for="form-nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre <span class="text-red-500">*</span></label>
            <input type="text" id="form-nombre" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] outline-none transition-all" />
            <input type="text" id="form-nombre" required maxlength="50" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] outline-none transition-all" />
          </div>
          <div id="desc-container" class="hidden">
            <label for="form-descripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
            <textarea id="form-descripcion" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] outline-none transition-all resize-none"></textarea>
            <textarea id="form-descripcion" rows="3" maxlength="200" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#1E3A5F] focus:border-[#1E3A5F] outline-none transition-all resize-none"></textarea>
          </div>
          <div class="flex items-center gap-2 mt-4">
            <input type="checkbox" id="form-activo" checked class="w-4 h-4 text-[#1E3A5F] border-gray-300 rounded focus:ring-[#1E3A5F]" />
            <label for="form-activo" class="text-sm font-medium text-gray-700">Activo</label>
          </div>
        </div>
        <div class="mt-6 flex justify-end gap-3">
          <button type="button" onclick="closeModal()" class="px-4 py-2 text-gray-600 font-medium hover:bg-gray-100 rounded-lg transition-colors">Cancelar</button>
          <button type="submit" class="px-4 py-2 bg-[#1E3A5F] hover:bg-[#152842] text-white font-medium rounded-lg transition-colors flex items-center gap-2">
            Guardar
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL || 'https://zsddtosxnfqmbyxptkfs.supabase.co',
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpzZGR0b3N4bmZxbWJ5eHB0a2ZzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2NTc5MjEsImV4cCI6MjEwNDIzMzkyMX0.x7Oysn4OW3p5_Lwaj87vjdKOWvRyfeXKuQhGsO7XjGw'
  );

  let currentData = {
    marcas: [],
    tipos: [],
    viscosidades: []
  };

  // Utility to generate icons
  const iconEdit = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>`;
  const iconDelete = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>`;

  function getStatusBadge(activo) {
    if (activo === false) return '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Inactivo</span>';
    return '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Activo</span>';
  }

  async function loadData() {
    try {
      // Load Marcas
      const { data: marcas } = await supabase.from('marcas_vehiculo').select('*').order('nombre');
      currentData.marcas = marcas || [];
      renderMarcas();

      // Load Tipos
      const { data: tipos } = await supabase.from('tipos_trabajo').select('*').order('nombre');
      currentData.tipos = tipos || [];
      renderTipos();

      // Load Viscosidades
      const { data: viscosidades } = await supabase.from('viscosidades').select('*').order('nombre');
      currentData.viscosidades = viscosidades || [];
      renderViscosidades();
    } catch (error) {
      console.error('Error loading data:', error);
    }
  }

  function renderMarcas() {
    const tbody = document.getElementById('marcas-tbody');
    if (!currentData.marcas.length) {
      tbody.innerHTML = '<tr><td colspan="3" class="px-6 py-8 text-center text-gray-500">No hay marcas registradas.</td></tr>';
      return;
    }
    tbody.innerHTML = currentData.marcas.map(item => `
      <tr class="hover:bg-gray-50 transition-colors group">
        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${item.nombre}</td>
        <td class="px-6 py-4 whitespace-nowrap">${getStatusBadge(item.activo)}</td>
        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
          <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
            <button onclick="editItem('marcas', '${(item.id_marca || item.id_tipo || item.id_viscosidad)}')" class="text-blue-600 hover:text-blue-900 p-1 bg-blue-50 rounded" title="Editar">${iconEdit}</button>
            <button onclick="deleteItem('marcas', '${(item.id_marca || item.id_tipo || item.id_viscosidad)}')" class="text-red-600 hover:text-red-900 p-1 bg-red-50 rounded" title="Eliminar">${iconDelete}</button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  function renderTipos() {
    const tbody = document.getElementById('tipos-tbody');
    if (!currentData.tipos.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">No hay tipos de trabajo registrados.</td></tr>';
      return;
    }
    tbody.innerHTML = currentData.tipos.map(item => {
      const extraCount = item.campos_extra ? (Array.isArray(item.campos_extra) ? item.campos_extra.length : Object.keys(item.campos_extra).length) : 0;
      return `
      <tr class="hover:bg-gray-50 transition-colors group">
        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${item.nombre}</td>
        <td class="px-6 py-4 text-sm text-gray-500 truncate max-w-xs" title="${item.descripcion || ''}">${item.descripcion || '-'}</td>
        <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-500">
          <span class="bg-gray-100 text-gray-600 px-2 py-1 rounded text-xs font-medium">${extraCount} campos</span>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">${getStatusBadge(item.activo)}</td>
        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
          <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
            <button onclick="editItem('tipos', '${(item.id_marca || item.id_tipo || item.id_viscosidad)}')" class="text-blue-600 hover:text-blue-900 p-1 bg-blue-50 rounded" title="Editar">${iconEdit}</button>
            <button onclick="deleteItem('tipos', '${(item.id_marca || item.id_tipo || item.id_viscosidad)}')" class="text-red-600 hover:text-red-900 p-1 bg-red-50 rounded" title="Eliminar">${iconDelete}</button>
          </div>
        </td>
      </tr>
    `}).join('');
  }

  function renderViscosidades() {
    const tbody = document.getElementById('viscosidades-tbody');
    if (!currentData.viscosidades.length) {
      tbody.innerHTML = '<tr><td colspan="3" class="px-6 py-8 text-center text-gray-500">No hay viscosidades registradas.</td></tr>';
      return;
    }
    tbody.innerHTML = currentData.viscosidades.map(item => `
      <tr class="hover:bg-gray-50 transition-colors group">
        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${item.nombre}</td>
        <td class="px-6 py-4 whitespace-nowrap">${getStatusBadge(item.activo)}</td>
        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
          <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
            <button onclick="editItem('viscosidades', '${(item.id_marca || item.id_tipo || item.id_viscosidad)}')" class="text-blue-600 hover:text-blue-900 p-1 bg-blue-50 rounded" title="Editar">${iconEdit}</button>
            <button onclick="deleteItem('viscosidades', '${(item.id_marca || item.id_tipo || item.id_viscosidad)}')" class="text-red-600 hover:text-red-900 p-1 bg-red-50 rounded" title="Eliminar">${iconDelete}</button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  // Window globals for inline handlers
  window.switchTab = function(tabName) {
    // Hide all sections
    document.querySelectorAll('.tab-content').forEach(el => {
      el.classList.add('hidden');
      el.classList.remove('block');
    });
    
    // Reset all buttons
    document.querySelectorAll('.tab-btn').forEach(el => {
      el.classList.remove('bg-primary/10', 'text-primary');
      el.classList.add('text-gray-500');
    });

    // Show active section
    document.getElementById(`section-${tabName}`).classList.remove('hidden');
    document.getElementById(`section-${tabName}`).classList.add('block');
    
    // Highlight active button
    document.getElementById(`tab-${tabName}`).classList.remove('text-gray-500');
    document.getElementById(`tab-${tabName}`).classList.add('bg-primary/10', 'text-primary');
  };

  window.openModal = function(entity) {
    document.getElementById('crud-form').reset();
    document.getElementById('form-entity').value = entity;
    document.getElementById('form-id').value = '';
    
    document.getElementById('desc-container').classList.toggle('hidden', entity !== 'tipos');
    
    const titles = {
      marcas: 'Nueva Marca de Vehículo',
      tipos: 'Nuevo Tipo de Trabajo',
      viscosidades: 'Nueva Viscosidad'
    };
    document.getElementById('modal-title').textContent = titles[entity];
    
    const modal = document.getElementById('crud-modal');
    modal.classList.remove('hidden');
    // slight delay for transition
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      document.getElementById('crud-modal-content').classList.remove('scale-95');
    }, 10);
  };

  window.closeModal = function() {
    const modal = document.getElementById('crud-modal');
    modal.classList.add('opacity-0');
    document.getElementById('crud-modal-content').classList.add('scale-95');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 200);
  };

  window.editItem = function(entity, id) {
    const item = currentData[entity].find(i => i.id_marca == id || i.id_tipo == id || i.id_viscosidad == id);
    if (!item) return;

    window.openModal(entity);
    document.getElementById('form-id').value = (item.id_marca || item.id_tipo || item.id_viscosidad);
    document.getElementById('form-nombre').value = item.nombre;
    
    if (entity === 'tipos') {
      document.getElementById('form-descripcion').value = item.descripcion || '';
    }
    
    const activoCheckbox = document.getElementById('form-activo');
    activoCheckbox.checked = item.activo !== false; // handle null as true

    const titles = {
      marcas: 'Editar Marca',
      tipos: 'Editar Tipo de Trabajo',
      viscosidades: 'Editar Viscosidad'
    };
    document.getElementById('modal-title').textContent = titles[entity];
  };

  window.deleteItem = async function(entity, id) {
    if (!confirm('¿Estás seguro de eliminar este registro? Esta acción no se puede deshacer.')) return;
    
    const tableMap = {
      marcas: 'marcas_vehiculo',
      tipos: 'tipos_trabajo',
      viscosidades: 'viscosidades'
    };
    
    try {
      const { error } = await supabase.from(tableMap[entity]).delete().eq(entity === 'marcas' ? 'id_marca' : entity === 'tipos' ? 'id_tipo' : 'id_viscosidad', id);
      if (error) throw error;
      await loadData();
    } catch (error) {
      console.error('Error al eliminar:', error);
      alert('Hubo un error al eliminar el registro.');
    }
  };

  document.getElementById('crud-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const entity = document.getElementById('form-entity').value;
    const id = document.getElementById('form-id').value;
    const tableMap = {
      marcas: 'marcas_vehiculo',
      tipos: 'tipos_trabajo',
      viscosidades: 'viscosidades'
    };
    
    const payload = {
      nombre: document.getElementById('form-nombre').value,
      activo: document.getElementById('form-activo').checked
    };
    
    if (entity === 'tipos') {
      payload.descripcion = document.getElementById('form-descripcion').value;
    }

    try {
      if (id) {
        // Update
        const { error } = await supabase.from(tableMap[entity]).update(payload).eq(entity === 'marcas' ? 'id_marca' : entity === 'tipos' ? 'id_tipo' : 'id_viscosidad', id);
        if (error) throw error;
      } else {
        // Insert
        const { error } = await supabase.from(tableMap[entity]).insert([payload]);
        if (error) throw error;
      }
      
      closeModal();
      await loadData();
    } catch (error) {
      console.error('Error al guardar:', error);
      alert('Hubo un error al guardar el registro.');
    }
  });

  // Initial load
  loadData();
</script>
