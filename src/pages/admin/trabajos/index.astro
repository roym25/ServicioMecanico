---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Historial de Trabajos">
  <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-[#1E3A5F]">Trabajos</h1>
      <p class="text-gray-600 mt-2">Gestión de trabajos y mantenimientos</p>
    </div>
    <button id="btnNuevoTrabajo" class="px-4 py-2 bg-[#1E3A5F] text-white rounded hover:bg-[#1E3A5F]/90 transition-colors flex items-center self-start md:self-auto">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Nuevo Trabajo
    </button>
  </div>

  <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 mb-6 flex flex-col md:flex-row gap-4">
    <div class="flex-1 relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input type="text" id="searchInput" placeholder="Buscar por vehículo, cliente o descripción..." class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-[#1E3A5F] focus:border-[#1E3A5F] sm:text-sm">
    </div>
    <select id="statusFilter" class="block w-full md:w-48 pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-[#1E3A5F] focus:border-[#1E3A5F] sm:text-sm rounded-md">
      <option value="all">Todos los estados</option>
      <option value="in-progress">En proceso</option>
      <option value="completed">Entregados</option>
    </select>
  </div>

  <!-- Loading State -->
  <div id="loadingState" class="py-12 text-center hidden">
    <svg class="animate-spin h-8 w-8 text-[#1E3A5F] mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <p class="text-gray-500">Cargando trabajos...</p>
  </div>

  <!-- Table -->
  <div id="tableContainer" class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-gray-50 text-gray-600">
          <tr>
            <th class="px-4 py-3 font-medium">Fecha Ingreso</th>
            <th class="px-4 py-3 font-medium">Vehículo</th>
            <th class="px-4 py-3 font-medium">Tipo de Trabajo</th>
            <th class="px-4 py-3 font-medium">Descripción</th>
            <th class="px-4 py-3 font-medium">Costo</th>
            <th class="px-4 py-3 font-medium">Km Entrada</th>
            <th class="px-4 py-3 font-medium">Estado</th>
            <th class="px-4 py-3 font-medium text-right">Acciones</th>
          </tr>
        </thead>
        <tbody id="tableBody" class="divide-y divide-gray-100">
          <!-- Rendered by JS -->
        </tbody>
      </table>
    </div>
    <div id="emptyState" class="hidden px-6 py-12 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      <h3 class="text-lg font-medium text-gray-900 mb-1">No se encontraron trabajos</h3>
      <p class="text-gray-500">Intenta con otra búsqueda o registra un nuevo trabajo.</p>
    </div>
  </div>

  <!-- Modal Formulario -->
  <div id="formModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-2xl max-h-[90vh] flex flex-col">
      <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-[#F8F9FA] rounded-t-lg">
        <h2 id="modalTitle" class="text-xl font-bold text-[#1E3A5F]">Nuevo Trabajo</h2>
        <button type="button" class="close-modal text-gray-400 hover:text-gray-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <div class="p-6 overflow-y-auto flex-1">
        <form id="trabajoForm" class="space-y-6">
          <input type="hidden" id="id_trabajo" name="id_trabajo">
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="col-span-1 md:col-span-2">
              <label for="id_vehiculo" class="block text-sm font-medium text-gray-700 mb-1">Vehículo <span class="text-[#E63946]">*</span></label>
              <div class="flex items-center gap-2">
                <select id="id_vehiculo" name="id_vehiculo" required class="block flex-1 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-[#1E3A5F] focus:border-[#1E3A5F]">
                  <option value="">Seleccione un vehículo</option>
                </select>
                <button type="button" onclick="loadVehiculos()" title="Actualizar lista de vehículos" class="px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-md text-xs font-bold flex items-center justify-center shrink-0 transition">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                </button>
                <button type="button" id="btnOpenQuickVehiculo" title="Registrar nuevo vehículo" class="px-3 py-2 bg-[#E63946] hover:bg-[#d63340] text-white rounded-md text-xs font-bold flex items-center justify-center shrink-0 transition">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                </button>
              </div>
              <p class="text-[11px] text-gray-500 mt-1">Si el vehículo o cliente no existe, usa los botones (+) para registrarlos rápidamente sin salir de esta pantalla.</p>
            </div>

            <div>
              <label for="id_tipo_trabajo" class="block text-sm font-medium text-gray-700 mb-1">Tipo de Trabajo</label>
              <select id="id_tipo_trabajo" name="id_tipo_trabajo" class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-[#1E3A5F] focus:border-[#1E3A5F]">
                <option value="">Ninguno (Genérico)</option>
              </select>
            </div>


            
            <div class="col-span-1 md:col-span-2">
              <label for="descripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción <span class="text-[#E63946]">*</span></label>
              <textarea id="descripcion" name="descripcion" rows="2" required maxlength="500" class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-[#1E3A5F] focus:border-[#1E3A5F]"></textarea>
            </div>

            <!-- Dynamic Fields Container -->
            <div id="dynamicFieldsContainer" class="col-span-1 md:col-span-2 space-y-4 border-t border-b border-gray-100 py-4 hidden bg-gray-50 px-4 rounded-md">
              <h3 class="text-sm font-medium text-[#1E3A5F] mb-3">Campos Específicos</h3>
              <div id="dynamicFields" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
            </div>

            <div>
              <label for="km_entrada" class="block text-sm font-medium text-gray-700 mb-1">Kilometraje de Entrada <span class="text-[#E63946]">*</span></label>
              <input type="number" id="km_entrada" name="km_entrada" required min="0" max="999999" class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-[#1E3A5F] focus:border-[#1E3A5F]">
            </div>

            <div>
              <label for="costo" class="block text-sm font-medium text-gray-700 mb-1">Costo (MXN)</label>
              <input type="number" id="costo" name="costo" step="0.01" min="0" max="9999999" class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-[#1E3A5F] focus:border-[#1E3A5F]">
            </div>

            <div>
              <label for="fecha_ingreso" class="block text-sm font-medium text-gray-700 mb-1">Fecha Ingreso <span class="text-[#E63946]">*</span></label>
              <input type="date" id="fecha_ingreso" name="fecha_ingreso" required class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-[#1E3A5F] focus:border-[#1E3A5F]">
            </div>

            <div>
              <label for="fecha_entrega" class="block text-sm font-medium text-gray-700 mb-1">Fecha Entrega</label>
              <input type="date" id="fecha_entrega" name="fecha_entrega" class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-[#1E3A5F] focus:border-[#1E3A5F]">
            </div>

            <div class="col-span-1 md:col-span-2">
              <label for="notas" class="block text-sm font-medium text-gray-700 mb-1">Notas</label>
              <textarea id="notas" name="notas" rows="2" maxlength="1000" class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-[#1E3A5F] focus:border-[#1E3A5F]"></textarea>
            </div>
          </div>
        </form>
      </div>
      
      <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex justify-end gap-3 rounded-b-lg">
        <button type="button" class="close-modal px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded hover:bg-gray-50 transition-colors">
          Cancelar
        </button>
        <button type="submit" form="trabajoForm" class="px-4 py-2 bg-[#1E3A5F] text-white rounded hover:bg-[#1E3A5F]/90 transition-colors flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Guardar
        </button>
      </div>
    </div>
  </div>

  <!-- Detail Modal -->
  <div id="detailModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-2xl max-h-[90vh] flex flex-col">
      <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-[#F8F9FA] rounded-t-lg">
        <h2 class="text-xl font-bold text-[#1E3A5F]">Detalle de Trabajo</h2>
        <button type="button" class="close-detail-modal text-gray-400 hover:text-gray-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <div class="p-6 overflow-y-auto flex-1">
        <div id="detailContent" class="space-y-6">
          <!-- Inyectado por JS -->
        </div>
      </div>
      
      <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex justify-end gap-3 rounded-b-lg">
        <button type="button" class="close-detail-modal px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded hover:bg-gray-50 transition-colors">
          Cerrar
        </button>
        <button type="button" id="btn-edit-from-view" class="px-4 py-2 bg-[#1E3A5F] text-white rounded hover:bg-[#1E3A5F]/90 transition-colors flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Editar
        </button>
      </div>
    </div>
  </div>

  <!-- Delete Modal -->
  <div id="deleteModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md">
      <div class="p-6 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-[#E63946] mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h3 class="text-lg font-bold text-gray-900 mb-2">¿Eliminar trabajo?</h3>
        <p class="text-gray-500 mb-6">Esta acción no se puede deshacer. ¿Estás seguro que deseas eliminar este trabajo?</p>
        <div class="flex justify-center gap-3">
          <button type="button" class="close-delete-modal px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded hover:bg-gray-50 transition-colors">
            Cancelar
          </button>
          <button type="button" id="confirmDeleteBtn" class="px-4 py-2 bg-[#E63946] text-white rounded hover:bg-[#E63946]/90 transition-colors">
            Sí, eliminar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Vehiculo Modal -->
  <div id="quickVehiculoModal" class="fixed inset-0 bg-black/60 z-[60] flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md flex flex-col">
      <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-[#F8F9FA] rounded-t-lg">
        <h2 class="text-lg font-bold text-[#1E3A5F]">Registro Rápido de Vehículo</h2>
        <h2 class="text-lg font-bold text-[#1E3A5F]">Nuevo Vehículo</h2>
        <button type="button" class="close-qv-modal text-gray-400 hover:text-gray-600 transition-colors">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <div class="p-6 overflow-y-auto">
        <form id="qvForm" class="space-y-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Cliente <span class="text-red-500">*</span></label>
            <div class="flex gap-2">
              <select id="qv_id_cliente" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
                <option value="">Selecciona un cliente...</option>
              </select>
              <button type="button" id="btnOpenQuickCliente" class="px-3 py-2 bg-secondary text-white rounded-xl text-xs font-bold flex items-center justify-center shrink-0 hover:bg-secondary/90 transition" title="Nuevo Cliente">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              </button>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Marca <span class="text-red-500">*</span></label>
              <select id="qv_marca" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
                <option value="">Selecciona marca...</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Modelo <span class="text-red-500">*</span></label>
              <input type="text" id="qv_modelo" required placeholder="Ej. Sentra" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
              <input type="text" id="qv_modelo" required maxlength="50" placeholder="Ej. Sentra" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Año <span class="text-red-500">*</span></label>
              <input type="number" id="qv_anio" required placeholder="Ej. 2020" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
              <input type="number" id="qv_anio" required min="1950" max="2027" placeholder="Ej. 2020" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Km Actual <span class="text-red-500">*</span></label>
              <input type="number" id="qv_km" required placeholder="Ej. 75000" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
              <input type="number" id="qv_km" required min="0" max="999999" placeholder="Ej. 75000" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
            </div>
            <div class="col-span-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Número de Serie (VIN)</label>
              <input type="text" id="qv_numserie" placeholder="Opcional" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm uppercase font-mono focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
              <input type="text" id="qv_numserie" placeholder="Opcional" minlength="17" maxlength="17" pattern="^[A-HJ-NPR-Za-hj-npr-z0-9]{17}$" title="Debe tener exactamente 17 caracteres válidos (sin I, O, Q)." class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm uppercase font-mono focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
            </div>
          </div>
          <p class="text-[11px] text-gray-500 mt-4 text-center">* Si requieres ver o editar todos los detalles, ve a la sección de Vehículos.</p>
        </form>
      </div>
      <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex justify-end gap-3 rounded-b-lg">
        <button type="button" class="close-qv-modal px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded hover:bg-gray-50 transition-colors">Cancelar</button>
        <button type="submit" form="qvForm" class="px-4 py-2 bg-[#1E3A5F] text-white rounded hover:bg-[#1E3A5F]/90 transition-colors flex items-center">Guardar</button>
      </div>
    </div>
  </div>

  <!-- Quick Cliente Modal -->
  <div id="quickClienteModal" class="fixed inset-0 bg-black/70 z-[70] flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md flex flex-col">
      <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-[#F8F9FA] rounded-t-lg">
        <h2 class="text-lg font-bold text-[#1E3A5F]">Registro Rápido de Cliente</h2>
        <h2 class="text-lg font-bold text-[#1E3A5F]">Nuevo Cliente</h2>
        <button type="button" class="close-qc-modal text-gray-400 hover:text-gray-600 transition-colors">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <div class="p-6 overflow-y-auto">
        <form id="qcForm" class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Nombre <span class="text-red-500">*</span></label>
              <input type="text" id="qc_nombre" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
              <input type="text" id="qc_nombre" required minlength="2" maxlength="50" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Apellido <span class="text-red-500">*</span></label>
              <input type="text" id="qc_apellido" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
              <input type="text" id="qc_apellido" required minlength="2" maxlength="50" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
            </div>
            <div class="col-span-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Teléfono <span class="text-red-500">*</span></label>
              <input type="text" id="qc_telefono" required class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
              <input type="text" id="qc_telefono" required minlength="10" maxlength="20" pattern="^\+?[0-9\s\-]+$" title="Debe contener entre 10 y 20 números, espacios o guiones." class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
            </div>
            <div class="col-span-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Correo Electrónico</label>
              <input type="email" id="qc_email" placeholder="Opcional" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
              <input type="email" id="qc_email" placeholder="Opcional" maxlength="100" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#1E3A5F]">
            </div>
          </div>
          <p class="text-[11px] text-gray-500 mt-4 text-center">* Si requieres ver o editar todos los detalles, ve a la sección de Clientes.</p>
        </form>
      </div>
      <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex justify-end gap-3 rounded-b-lg">
        <button type="button" class="close-qc-modal px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded hover:bg-gray-50 transition-colors">Cancelar</button>
        <button type="submit" form="qcForm" class="px-4 py-2 bg-[#1E3A5F] text-white rounded hover:bg-[#1E3A5F]/90 transition-colors flex items-center">Guardar</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="fixed bottom-4 right-4 transform translate-y-full opacity-0 transition-all duration-300 z-50">
    <div class="bg-white border-l-4 rounded shadow-lg px-4 py-3 flex items-center min-w-[300px]">
      <div id="toastIcon" class="mr-3"></div>
      <div>
        <p id="toastTitle" class="font-bold text-sm"></p>
        <p id="toastMessage" class="text-sm text-gray-600"></p>
      </div>
    </div>
  </div>



<script>
  import { createClient } from '@supabase/supabase-js';
  
  const supabase = createClient(
    'https://zsddtosxnfqmbyxptkfs.supabase.co',
    'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpzZGR0b3N4bmZxbWJ5eHB0a2ZzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2NTc5MjEsImV4cCI6MjEwNDIzMzkyMX0.x7Oysn4OW3p5_Lwaj87vjdKOWvRyfeXKuQhGsO7XjGw'
  );

  let trabajos = [];
  let tiposTrabajo = [];
  let vehiculos = [];
  let currentTrabajoId = null;
  let dynamicFieldDefs = [];

  // DOM Elements
  const loadingState = document.getElementById('loadingState');
  const tableContainer = document.getElementById('tableContainer');
  const tableBody = document.getElementById('tableBody');
  const emptyState = document.getElementById('emptyState');
  const searchInput = document.getElementById('searchInput');
  const statusFilter = document.getElementById('statusFilter');
  
  const formModal = document.getElementById('formModal');
  const trabajoForm = document.getElementById('trabajoForm');
  const modalTitle = document.getElementById('modalTitle');
  const btnNuevoTrabajo = document.getElementById('btnNuevoTrabajo');
  
  const detailModal = document.getElementById('detailModal');
  const detailContent = document.getElementById('detailContent');
  
  const deleteModal = document.getElementById('deleteModal');
  const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
  
  const dynamicFieldsContainer = document.getElementById('dynamicFieldsContainer');
  const dynamicFields = document.getElementById('dynamicFields');
  const idTipoTrabajoSelect = document.getElementById('id_tipo_trabajo');

  // Format Helpers
  const formatCurrency = (val) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(val || 0);
  const formatDate = (dateStr) => {
    if (!dateStr) return '-';
    const [year, month, day] = dateStr.split('T')[0].split('-');
    return `${day}/${month}/${year}`;
  };
  const formatNumber = (num) => new Intl.NumberFormat('es-MX').format(num || 0);

  // Initialize
  async function init() {
    showLoading(true);
    await Promise.all([loadTrabajos(), loadTiposTrabajo(), loadVehiculos()]);
    
    // Set today as default for fecha_ingreso
    document.getElementById('fecha_ingreso').valueAsDate = new Date();
    
    setupEventListeners();
    showLoading(false);

    // Auto-open logic after everything is loaded
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('new') === 'true') {
      openFormModal();
      window.history.replaceState({}, document.title, window.location.pathname);
    } else if (urlParams.get('view')) {
      const viewId = parseInt(urlParams.get('view'), 10);
      if (window.viewTrabajo && !isNaN(viewId)) {
        window.viewTrabajo(viewId);
      }
      window.history.replaceState({}, document.title, window.location.pathname);
    }
  }

  function showLoading(show) {
    if (show) {
      loadingState.classList.remove('hidden');
      tableContainer.classList.add('hidden');
    } else {
      loadingState.classList.add('hidden');
      tableContainer.classList.remove('hidden');
      renderTable();
    }
  }

  // Load Data
  async function loadTrabajos() {
    const { data, error } = await supabase
      .from('trabajos')
      .select('*, tipos_trabajo(nombre, descripcion, campos_extra), vehiculos(marca, modelo, id_cliente, clientes(nombre, apellido))')
      .order('fecha_ingreso', { ascending: false });
      
    if (error) {
      showToast('Error', 'No se pudieron cargar los trabajos', 'error');
      console.error(error);
    } else {
      trabajos = data || [];
    }
  }

  async function loadTiposTrabajo() {
    const { data, error } = await supabase
      .from('tipos_trabajo')
      .select('*')
      .eq('activo', true)
      .order('nombre');
      
    if (!error && data) {
      tiposTrabajo = data;
      const select = document.getElementById('id_tipo_trabajo');
      select.innerHTML = '<option value="">Ninguno (Genérico)</option>';
      data.forEach(t => {
        const option = document.createElement('option');
        option.value = t.id_tipo;
        option.textContent = t.nombre;
        option.dataset.campos = JSON.stringify(t.campos_extra || []);
        option.dataset.desc = t.descripcion || '';
        select.appendChild(option);
      });
    }
  }

  window.loadVehiculos = async function loadVehiculos() {
    const btnRefresh = document.querySelector('[title="Actualizar lista de vehículos"] svg');
    if (btnRefresh) btnRefresh.classList.add('animate-spin');
    
    const { data, error } = await supabase
      .from('vehiculos')
      .select('*, clientes(nombre, apellido)')
      .order('marca');
      
    if (!error && data) {
      vehiculos = data;
      const select = document.getElementById('id_vehiculo');
      const currentVal = select.value; // preserve selection
      
      select.innerHTML = '<option value="">Seleccione un vehículo</option>';
      data.forEach(v => {
        const option = document.createElement('option');
        option.value = v.id_vehiculo;
        option.textContent = `${v.marca} ${v.modelo} - Dueño: ${v.clientes?.nombre || ''} ${v.clientes?.apellido || ''}`;
        select.appendChild(option);
      });
      
      if (currentVal) select.value = currentVal;
    }
    
    if (btnRefresh) setTimeout(() => btnRefresh.classList.remove('animate-spin'), 500);
  }

  // Event Listeners
  function setupEventListeners() {
    searchInput.addEventListener('input', renderTable);
    statusFilter.addEventListener('change', renderTable);
    
    // Auto refresh vehicles when coming back to the tab
    window.addEventListener('focus', () => {
      if (!formModal.classList.contains('hidden')) {
        window.loadVehiculos();
      }
    });
    
    btnNuevoTrabajo.addEventListener('click', () => openFormModal());
    
    document.querySelectorAll('.close-modal').forEach(btn => {
      btn.addEventListener('click', closeFormModal);
    });
    
    document.querySelectorAll('.close-detail-modal').forEach(btn => {
      btn.addEventListener('click', () => detailModal.classList.add('hidden'));
    });
    
    document.querySelectorAll('.close-delete-modal').forEach(btn => {
      btn.addEventListener('click', () => deleteModal.classList.add('hidden'));
    });
    
    trabajoForm.addEventListener('submit', handleFormSubmit);
    confirmDeleteBtn.addEventListener('click', executeDelete);
    
    idTipoTrabajoSelect.addEventListener('change', handleTipoTrabajoChange);
  }

  async function handleTipoTrabajoChange(e, prefillDetalles = null, isEdit = false) {
    const selectedOption = idTipoTrabajoSelect.options[idTipoTrabajoSelect.selectedIndex];
    
    // Autofill desc if we have a default description for this type.
    // If it's a new form (not editing an existing one), overwrite it.
    const descInput = document.getElementById('descripcion');
    if (!isEdit && selectedOption) {
      descInput.value = selectedOption.dataset.desc || '';
    }

    dynamicFields.innerHTML = '';
    dynamicFieldDefs = [];

    if (selectedOption.value && selectedOption.dataset.campos) {
      try {
        const campos = JSON.parse(selectedOption.dataset.campos);
        if (campos && campos.length > 0) {
          dynamicFieldDefs = campos;
          dynamicFieldsContainer.classList.remove('hidden');
          
          for (const campo of campos) {
            const div = document.createElement('div');
            
            const fieldId = `dyn_${campo.nombre}`;
            
            const label = document.createElement('label');
            label.className = 'block text-sm font-medium text-gray-700 mb-1';
            label.textContent = campo.etiqueta;
            label.htmlFor = fieldId;
            div.appendChild(label);
            
            if (campo.tipo === 'text') {
              const input = document.createElement('input');
              input.type = 'text';
              input.id = fieldId;
              input.name = fieldId;
              input.className = 'block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-[#1E3A5F] focus:border-[#1E3A5F]';
              if (prefillDetalles && prefillDetalles[campo.nombre]) {
                input.value = prefillDetalles[campo.nombre];
              }
              div.appendChild(input);
            } 
            else if (campo.tipo === 'select') {
              const select = document.createElement('select');
              select.id = fieldId;
              select.name = fieldId;
              select.className = 'block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-[#1E3A5F] focus:border-[#1E3A5F]';
              
              const defaultOpt = document.createElement('option');
              defaultOpt.value = "";
              defaultOpt.textContent = "Seleccionar...";
              select.appendChild(defaultOpt);
              
              if (campo.opciones) {
                campo.opciones.forEach(opt => {
                  const o = document.createElement('option');
                  o.value = opt;
                  o.textContent = opt;
                  select.appendChild(o);
                });
              } else if (campo.opciones_tabla) {
                // Fetch from tabla
                const { data } = await supabase.from(campo.opciones_tabla).select('*').eq('activo', true);
                if (data) {
                  data.forEach(item => {
                    const o = document.createElement('option');
                    o.value = item.nombre;
                    o.textContent = item.nombre;
                    select.appendChild(o);
                  });
                }
              }
              
              if (prefillDetalles && prefillDetalles[campo.nombre]) {
                select.value = prefillDetalles[campo.nombre];
              }
              div.appendChild(select);
            }
            else if (campo.tipo === 'checkbox') {
              const wrapper = document.createElement('div');
              wrapper.className = 'flex items-center mt-2';
              const input = document.createElement('input');
              input.type = 'checkbox';
              input.id = fieldId;
              input.name = fieldId;
              input.className = 'h-4 w-4 text-[#1E3A5F] focus:ring-[#1E3A5F] border-gray-300 rounded';
              if (prefillDetalles && prefillDetalles[campo.nombre]) {
                input.checked = prefillDetalles[campo.nombre] === true;
              }
              
              const label2 = document.createElement('label');
              label2.className = 'ml-2 block text-sm text-gray-900';
              label2.textContent = "Sí / Activo";
              label2.htmlFor = fieldId;
              
              wrapper.appendChild(input);
              wrapper.appendChild(label2);
              div.appendChild(wrapper);
            }
            
            dynamicFields.appendChild(div);
          }
        } else {
          dynamicFieldsContainer.classList.add('hidden');
        }
      } catch (e) {
        console.error("Error parsing campos_extra", e);
        dynamicFieldsContainer.classList.add('hidden');
      }
    } else {
      dynamicFieldsContainer.classList.add('hidden');
    }
  }

  // Rendering
  function renderTable() {
    const term = searchInput.value.toLowerCase();
    const status = statusFilter.value;
    
    const filtered = trabajos.filter(t => {
      const formattedDate = formatDate(t.fecha_ingreso).toLowerCase();
      const matchSearch = 
        (t.vehiculos?.marca || '').toLowerCase().includes(term) ||
        (t.vehiculos?.modelo || '').toLowerCase().includes(term) ||
        (t.vehiculos?.clientes?.nombre || '').toLowerCase().includes(term) ||
        (t.vehiculos?.clientes?.apellido || '').toLowerCase().includes(term) ||
        (t.descripcion || '').toLowerCase().includes(term) ||
        formattedDate.includes(term) ||
        (t.fecha_ingreso || '').toLowerCase().includes(term);
        
      let matchStatus = true;
      const estadoActual = t.estado || 'En proceso';
      if (status === 'in-progress') matchStatus = estadoActual !== 'Entregado' && estadoActual !== 'Terminado';
      if (status === 'completed') matchStatus = estadoActual === 'Entregado' || estadoActual === 'Terminado';
      
      return matchSearch && matchStatus;
    });

    tableBody.innerHTML = '';
    
    if (filtered.length === 0) {
      emptyState.classList.remove('hidden');
      tableBody.parentElement.classList.add('hidden');
    } else {
      emptyState.classList.add('hidden');
      tableBody.parentElement.classList.remove('hidden');
      
      filtered.forEach(t => {
        const estadoReal = t.estado === 'Entregado' || t.fecha_entrega ? 'Entregado' : (t.estado || 'En proceso');
        const isCompleted = estadoReal === 'Entregado' || estadoReal === 'Terminado';
        const badgeColor = isCompleted ? 'bg-[#2D6A4F]/10 text-[#2D6A4F]' : 'bg-[#F4A261]/10 text-[#F4A261]';
        
        const vehiculo = t.vehiculos ? `${t.vehiculos.marca} ${t.vehiculos.modelo}` : '-';
        const cliente = t.vehiculos?.clientes ? `${t.vehiculos.clientes.nombre} ${t.vehiculos.clientes.apellido}` : '-';
        const vehiculoUrl = `/admin/vehiculos/detalle?id=${t.id_vehiculo}`;

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-gray-50 transition-colors';
        tr.innerHTML = `
          <td class="px-4 py-3">${formatDate(t.fecha_ingreso)}</td>
          <td class="px-4 py-3">
            <a href="${vehiculoUrl}" class="font-medium text-[#1E3A5F] hover:underline">${vehiculo}</a>
          </td>
          <td class="px-4 py-3 text-gray-600">${t.tipos_trabajo?.nombre || 'Genérico'}</td>
          <td class="px-4 py-3 max-w-xs truncate" title="${t.descripcion}">${t.descripcion}</td>
          <td class="px-4 py-3 font-medium">${formatCurrency(t.costo)}</td>
          <td class="px-4 py-3 text-gray-600">${formatNumber(t.km_entrada)}</td>
          <td class="px-4 py-3">
            <span class="px-2.5 py-1 rounded-full text-xs font-medium ${badgeColor}">
              ${estadoReal}
            </span>
          </td>
          <td class="px-4 py-3 text-right">
            <div class="flex justify-end gap-2">
              <button onclick="window.viewTrabajo(${t.id_trabajo})" class="p-1 text-gray-400 hover:text-[#1E3A5F] transition-colors" title="Ver detalles">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
              <button onclick="window.editTrabajo(${t.id_trabajo})" class="p-1 text-gray-400 hover:text-blue-600 transition-colors" title="Editar">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              </button>
              <button onclick="window.confirmDelete(${t.id_trabajo})" class="p-1 text-gray-400 hover:text-[#E63946] transition-colors" title="Eliminar">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
          </td>
        `;
        tableBody.appendChild(tr);
      });
    }
  }

  // Modals Actions
  function openFormModal(trabajo = null) {
    trabajoForm.reset();
    dynamicFields.innerHTML = '';
    dynamicFieldsContainer.classList.add('hidden');
    dynamicFieldDefs = [];
    
    if (trabajo) {
      modalTitle.textContent = 'Editar Trabajo';
      document.getElementById('id_trabajo').value = trabajo.id_trabajo;
      document.getElementById('id_vehiculo').value = trabajo.id_vehiculo;
      document.getElementById('id_tipo_trabajo').value = trabajo.id_tipo_trabajo || '';
      document.getElementById('descripcion').value = trabajo.descripcion;
      document.getElementById('km_entrada').value = trabajo.km_entrada;
      document.getElementById('costo').value = trabajo.costo || '';
      document.getElementById('fecha_ingreso').value = trabajo.fecha_ingreso ? trabajo.fecha_ingreso.split('T')[0] : '';
      document.getElementById('fecha_entrega').value = trabajo.fecha_entrega ? trabajo.fecha_entrega.split('T')[0] : '';
      document.getElementById('notas').value = trabajo.notas || '';
      
      // Trigger dynamic fields with prefill
      handleTipoTrabajoChange(null, trabajo.detalles, true);
    } else {
      modalTitle.textContent = 'Nuevo Trabajo';
      document.getElementById('id_trabajo').value = '';
      document.getElementById('fecha_ingreso').valueAsDate = new Date();
    }
    
    formModal.classList.remove('hidden');
  }

  function closeFormModal() {
    formModal.classList.add('hidden');
    trabajoForm.reset();
  }

  window.editTrabajo = (id) => {
    const trabajo = trabajos.find(t => t.id_trabajo === id);
    if (trabajo) openFormModal(trabajo);
  };

  window.viewTrabajo = (id) => {
    const t = trabajos.find(x => x.id_trabajo === id);
    if (!t) return;
    
    const estadoReal = t.estado === 'Entregado' || t.fecha_entrega ? 'Entregado' : (t.estado || 'En proceso');
    const isCompleted = estadoReal === 'Entregado' || estadoReal === 'Terminado';
    const badgeColor = isCompleted ? 'bg-[#2D6A4F]/10 text-[#2D6A4F]' : 'bg-[#F4A261]/10 text-[#F4A261]';
    
    const detallesHtml = Object.keys(t.detalles || {}).map(k => {
      // Intenta encontrar la etiqueta amigable si coincide con el tipo
      let etiqueta = k;
      if (t.tipos_trabajo?.campos_extra) {
        const c = t.tipos_trabajo.campos_extra.find(x => x.nombre === k);
        if (c) etiqueta = c.etiqueta;
      }
      const val = t.detalles[k];
      return `<div class="bg-gray-50 px-4 py-2 rounded">
        <span class="block text-xs text-gray-500 capitalize">${etiqueta.replace(/_/g, ' ')}</span>
        <span class="font-medium text-gray-900">${val === true ? 'Sí' : (val === false ? 'No' : val)}</span>
      </div>`;
    }).join('');

    detailContent.innerHTML = `
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-sm font-medium text-gray-500 mb-1">Vehículo</h3>
          <p class="text-lg font-medium text-[#1E3A5F]">${t.vehiculos?.marca} ${t.vehiculos?.modelo}</p>
          <p class="text-sm text-gray-600">Cliente: ${t.vehiculos?.clientes?.nombre} ${t.vehiculos?.clientes?.apellido}</p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-gray-500 mb-1">Estado</h3>
          <span class="px-2.5 py-1 rounded-full text-sm font-medium ${badgeColor}">
            ${estadoReal}
          </span>
        </div>
        
        <div class="md:col-span-2">
          <h3 class="text-sm font-medium text-gray-500 mb-1">Descripción del Trabajo</h3>
          <div class="bg-gray-50 p-3 rounded-md border border-gray-100">
            <p class="text-gray-800">${t.descripcion}</p>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-medium text-gray-500 mb-1">Tipo de Trabajo</h3>
          <p class="text-gray-900 font-medium">${t.tipos_trabajo?.nombre || 'Genérico'}</p>
        </div>
        


        <div>
          <h3 class="text-sm font-medium text-gray-500 mb-1">Kilometraje</h3>
          <p class="text-gray-900 font-medium">${formatNumber(t.km_entrada)} km</p>
        </div>

        <div>
          <h3 class="text-sm font-medium text-gray-500 mb-1">Costo</h3>
          <p class="text-gray-900 font-bold">${formatCurrency(t.costo)}</p>
        </div>

        <div>
          <h3 class="text-sm font-medium text-gray-500 mb-1">Fecha de Ingreso</h3>
          <p class="text-gray-900">${formatDate(t.fecha_ingreso)}</p>
        </div>

        <div>
          <h3 class="text-sm font-medium text-gray-500 mb-1">Fecha de Entrega</h3>
          <p class="text-gray-900">${formatDate(t.fecha_entrega) || 'Pendiente'}</p>
        </div>

        ${Object.keys(t.detalles || {}).length > 0 ? `
          <div class="md:col-span-2 pt-4 border-t border-gray-100">
            <h3 class="text-sm font-medium text-[#1E3A5F] mb-3">Detalles Específicos</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              ${detallesHtml}
            </div>
          </div>
        ` : ''}

        ${t.notas ? `
          <div class="md:col-span-2 pt-4 border-t border-gray-100">
            <h3 class="text-sm font-medium text-gray-500 mb-1">Notas Adicionales</h3>
            <div class="bg-yellow-50 p-3 rounded-md border border-yellow-100">
              <p class="text-gray-800">${t.notas}</p>
            </div>
          </div>
        ` : ''}
      </div>
    `;
    detailModal.classList.remove('hidden');
    
    // Configurar botón de editar
    const btnEditFromView = document.getElementById('btn-edit-from-view');
    if (btnEditFromView) {
      btnEditFromView.onclick = () => {
        detailModal.classList.add('hidden');
        window.editTrabajo(id);
      };
    }
  };

  window.confirmDelete = (id) => {
    currentTrabajoId = id;
    deleteModal.classList.remove('hidden');
  };

  // Form Submit
  async function handleFormSubmit(e) {
    e.preventDefault();
    
    const formData = new FormData(trabajoForm);
    const data = {
      id_vehiculo: formData.get('id_vehiculo'),
      id_tipo_trabajo: formData.get('id_tipo_trabajo') || null,
      descripcion: formData.get('descripcion'),
      km_entrada: formData.get('km_entrada'),
      costo: formData.get('costo') ? parseFloat(formData.get('costo')) : null,
      fecha_ingreso: formData.get('fecha_ingreso'),
      fecha_entrega: formData.get('fecha_entrega') || null,
      notas: formData.get('notas') || null,
    };
    
    const id = formData.get('id_trabajo');
    
    // Extract dynamic fields
    const detalles = {};
    dynamicFieldDefs.forEach(campo => {
      const fieldName = `dyn_${campo.nombre}`;
      if (campo.tipo === 'checkbox') {
        detalles[campo.nombre] = formData.has(fieldName);
      } else {
        const val = formData.get(fieldName);
        if (val) detalles[campo.nombre] = val;
      }
    });
    
    data.detalles = detalles;
    
    try {
      if (id) {
        const { error } = await supabase.from('trabajos').update(data).eq('id_trabajo', id);
        if (error) throw error;
        showToast('Éxito', 'Trabajo actualizado correctamente', 'success');
      } else {
        const { error } = await supabase.from('trabajos').insert([data]);
        if (error) throw error;
        showToast('Éxito', 'Trabajo registrado correctamente', 'success');
      }
      closeFormModal();
      await loadTrabajos();
      renderTable();
    } catch (error) {
      showToast('Error', 'Ocurrió un error al guardar', 'error');
      console.error(error);
    }
  }

  // Delete
  async function executeDelete() {
    if (!currentTrabajoId) return;
    
    try {
      const { error } = await supabase.from('trabajos').delete().eq('id_trabajo', currentTrabajoId);
      if (error) throw error;
      
      showToast('Éxito', 'Trabajo eliminado correctamente', 'success');
      deleteModal.classList.add('hidden');
      await loadTrabajos();
      renderTable();
    } catch (error) {
      showToast('Error', 'No se pudo eliminar el trabajo', 'error');
      console.error(error);
    }
  }

  // Toast System
  function showToast(title, message, type = 'success') {
    const toast = document.getElementById('toast');
    const toastTitle = document.getElementById('toastTitle');
    const toastMessage = document.getElementById('toastMessage');
    const toastIcon = document.getElementById('toastIcon');
    
    toastTitle.textContent = title;
    toastTitle.className = `font-bold text-sm ${type === 'success' ? 'text-[#2D6A4F]' : 'text-[#E63946]'}`;
    toastMessage.textContent = message;
    
    toast.className = `fixed bottom-4 right-4 transform transition-all duration-300 z-50 rounded shadow-lg px-4 py-3 flex items-center min-w-[300px] border-l-4 ${type === 'success' ? 'bg-white border-[#2D6A4F]' : 'bg-white border-[#E63946]'}`;
    
    toastIcon.innerHTML = type === 'success' 
      ? `<svg class="w-6 h-6 text-[#2D6A4F]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`
      : `<svg class="w-6 h-6 text-[#E63946]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
    
    // Animate in
    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-full', 'opacity-0');
    });
    
    // Hide after 3s
    setTimeout(() => {
      toast.classList.add('translate-y-full', 'opacity-0');
    }, 3000);
  }

  // Quick Create Logic
  const quickVehiculoModal = document.getElementById('quickVehiculoModal');
  const quickClienteModal = document.getElementById('quickClienteModal');
  const qvForm = document.getElementById('qvForm');
  const qcForm = document.getElementById('qcForm');
  
  document.getElementById('btnOpenQuickVehiculo').addEventListener('click', async () => {
    qvForm.reset();
    await loadQVCatalogos();
    quickVehiculoModal.classList.remove('hidden');
  });

  document.getElementById('btnOpenQuickCliente').addEventListener('click', () => {
    qcForm.reset();
    quickClienteModal.classList.remove('hidden');
  });

  document.querySelectorAll('.close-qv-modal').forEach(btn => btn.addEventListener('click', () => quickVehiculoModal.classList.add('hidden')));
  document.querySelectorAll('.close-qc-modal').forEach(btn => btn.addEventListener('click', () => quickClienteModal.classList.add('hidden')));

  async function loadQVCatalogos() {
    // Clientes
    const { data: clientes } = await supabase.from('clientes').select('id_cliente, nombre, apellido').order('nombre');
    const selectCl = document.getElementById('qv_id_cliente');
    const currCl = selectCl.value;
    selectCl.innerHTML = '<option value="">Selecciona un cliente...</option>';
    (clientes || []).forEach(c => {
      const o = document.createElement('option');
      o.value = c.id_cliente;
      o.textContent = `${c.nombre} ${c.apellido}`;
      selectCl.appendChild(o);
    });
    if(currCl) selectCl.value = currCl;

    // Marcas
    const { data: marcas } = await supabase.from('marcas_vehiculo').select('nombre').eq('activo', true).order('nombre');
    const selectMa = document.getElementById('qv_marca');
    const currMa = selectMa.value;
    selectMa.innerHTML = '<option value="">Selecciona marca...</option>';
    (marcas || []).forEach(m => {
      const o = document.createElement('option');
      o.value = m.nombre;
      o.textContent = m.nombre;
      selectMa.appendChild(o);
    });
    if(currMa) selectMa.value = currMa;
  }

  qcForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = {
      nombre: document.getElementById('qc_nombre').value.trim(),
      apellido: document.getElementById('qc_apellido').value.trim(),
      telefono: document.getElementById('qc_telefono').value.trim(),
      email: document.getElementById('qc_email').value.trim() || null
    };
    try {
      const { data, error } = await supabase.from('clientes').insert([payload]).select().single();
      if (error) throw error;
      showToast('Éxito', 'Cliente registrado', 'success');
      quickClienteModal.classList.add('hidden');
      await loadQVCatalogos();
      document.getElementById('qv_id_cliente').value = data.id_cliente;
    } catch (err) {
      showToast('Error', 'No se pudo guardar el cliente', 'error');
    }
  });

  qvForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    let numserieValue = document.getElementById('qv_numserie').value.trim().toUpperCase() || null;
    if (numserieValue) {
      if (numserieValue.length !== 17) {
        showToast('Error', 'El Número de Serie (VIN) debe tener exactamente 17 caracteres', 'error');
        return;
      }
      if (!/^[A-HJ-NPR-Z0-9]{17}$/.test(numserieValue)) {
        showToast('Error', 'El VIN contiene caracteres inválidos (No puede contener I, O, Q)', 'error');
        return;
      }
    }

    const payload = {
      id_cliente: parseInt(document.getElementById('qv_id_cliente').value),
      marca: document.getElementById('qv_marca').value,
      modelo: document.getElementById('qv_modelo').value.trim(),
      anio: parseInt(document.getElementById('qv_anio').value),
      km: parseInt(document.getElementById('qv_km').value),
      numserie: numserieValue
    };
    try {
      const { data, error } = await supabase.from('vehiculos').insert([payload]).select().single();
      if (error) throw error;
      showToast('Éxito', 'Vehículo registrado rápidamente', 'success');
      quickVehiculoModal.classList.add('hidden');
      await window.loadVehiculos();
      document.getElementById('id_vehiculo').value = data.id_vehiculo;
    } catch (err) {
      showToast('Error', 'No se pudo guardar el vehículo', 'error');
    }
  });

  // Run init directly
  init();
</script>
</AdminLayout>
