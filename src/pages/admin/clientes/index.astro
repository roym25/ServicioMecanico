---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Clientes" subtitle="Directorio y administración de clientes del taller">
  <!-- Toast Notification -->
  <div
    id="toast"
    class="fixed bottom-5 right-5 z-50 hidden max-w-sm w-full p-4 rounded-xl shadow-2xl text-sm font-medium transition-all duration-300 transform translate-y-4 opacity-0 flex items-center justify-between gap-3 border"
    role="status"
    aria-live="polite"
  >
    <div class="flex items-center gap-2.5">
      <span id="toast-icon" class="text-xl">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      </span>
      <span id="toast-message" class="text-xs sm:text-sm">Operación realizada con éxito</span>
    </div>
    <button id="toast-close" type="button" class="text-gray-400 hover:text-gray-700 p-1">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>

  <div class="space-y-6">
    <!-- Top Action Bar: Search & New Client Button -->
    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
      <!-- Search input -->
      <div class="relative flex-1 max-w-md">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </span>
        <input
          type="text"
          id="search-input"
          placeholder="Buscar por nombre, apellido, teléfono o RFC..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
        />
      </div>

      <!-- New Client Button -->
      <div class="flex items-center gap-3">
        <span id="client-count-badge" class="text-xs font-semibold text-gray-500 bg-gray-100 px-3 py-1.5 rounded-lg">
          0 clientes
        </span>
        <button
          type="button"
          id="btn-open-create-modal"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold bg-secondary hover:bg-secondary/90 text-white shadow-sm hover:shadow transition transform active:scale-95 shrink-0"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          <span>Nuevo Cliente</span>
        </button>
      </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <!-- Loading state -->
      <div id="table-loading" class="py-16 flex flex-col items-center justify-center space-y-3">
        <div class="w-10 h-10 border-4 border-primary/20 border-t-secondary rounded-full animate-spin"></div>
        <p class="text-sm font-medium text-gray-500">Cargando directorio de clientes...</p>
      </div>

      <!-- Responsive Table -->
      <div id="table-container" class="hidden overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-gray-50 text-xs font-bold uppercase tracking-wider text-gray-500 border-b border-gray-100">
            <tr>
              <th class="py-3.5 px-4">Nombre</th>
              <th class="py-3.5 px-4">Apellido</th>
              <th class="py-3.5 px-4">Teléfono</th>
              <th class="py-3.5 px-4">Correo</th>
              <th class="py-3.5 px-4">RFC</th>
              <th class="py-3.5 px-4 text-center">Acciones</th>
            </tr>
          </thead>
          <tbody id="clientes-table-body" class="divide-y divide-gray-100">
            <!-- Populated dynamically -->
          </tbody>
        </table>

        <!-- Empty state -->
        <div id="empty-state" class="hidden py-16 text-center">
          <div class="w-16 h-16 mx-auto mb-3 rounded-full bg-gray-100 flex items-center justify-center text-gray-400">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <h3 class="text-base font-bold text-gray-800">No se encontraron clientes</h3>
          <p class="text-xs text-gray-500 mt-1 max-w-sm mx-auto">
            No hay registros que coincidan con la búsqueda o el taller aún no tiene clientes dados de alta.
          </p>
          <button
            type="button"
            id="empty-btn-create"
            class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-secondary text-white hover:bg-secondary/90 transition shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Registrar Nuevo Cliente
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Create / Edit Client -->
  <div
    id="client-modal"
    class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <div class="bg-white rounded-2xl max-w-lg w-full shadow-2xl border border-gray-100 overflow-hidden my-8">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
        <div>
          <h3 id="modal-title" class="text-lg font-bold text-primary">Nuevo Cliente</h3>
          <p class="text-xs text-gray-500">Completa la información del cliente para su registro</p>
        </div>
        <button
          type="button"
          id="btn-close-modal"
          class="text-gray-400 hover:text-gray-600 p-1.5 rounded-lg hover:bg-gray-100 transition"
          aria-label="Cerrar modal"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Modal Form -->
      <form id="client-form" class="p-6 space-y-4">
        <input type="hidden" id="form-client-id" value="" />

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- Nombre -->
          <div>
            <label for="form-nombre" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Nombre <span class="text-secondary">*</span>
            </label>
            <input
              type="text"
              id="form-nombre"
              required
              placeholder="Ej. Juan"
              class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
            />
          </div>

          <!-- Apellido -->
          <div>
            <label for="form-apellido" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Apellido <span class="text-secondary">*</span>
            </label>
            <input
              type="text"
              id="form-apellido"
              required
              placeholder="Ej. Pérez"
              class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
            />
          </div>

          <!-- Apellido Materno -->
          <div>
            <label for="form-apellido-materno" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Ap. Materno
            </label>
            <input
              type="text"
              id="form-apellido-materno"
              placeholder="Opcional"
              class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
            />
          </div>
        </div>

        <!-- Domicilio -->
        <div>
          <label for="form-domicilio" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
            Domicilio
          </label>
          <input
            type="text"
            id="form-domicilio"
            placeholder="Ej. Av. Hidalgo #123, Col. Centro"
            class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Teléfono -->
          <div>
            <label for="form-telefono" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Teléfono
            </label>
            <input
              type="tel"
              id="form-telefono"
              placeholder="Ej. 55 1234 5678"
              class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
            />
          </div>

          <!-- RFC -->
          <div>
            <label for="form-rfc" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              RFC
            </label>
            <input
              type="text"
              id="form-rfc"
              maxlength="13"
              placeholder="Ej. PEGJ850101XYZ"
              class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-sm uppercase focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
            />
          </div>
        </div>

        <!-- Correo Electrónico -->
        <div>
          <label for="form-correo" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
            Correo Electrónico
          </label>
          <input
            type="email"
            id="form-correo"
            placeholder="Opcional"
            class="w-full px-3.5 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
          />
        </div>

        <!-- Modal Footer Buttons -->
        <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
          <button
            type="button"
            id="btn-cancel-modal"
            class="px-4 py-2.5 rounded-xl text-sm font-semibold text-gray-600 hover:bg-gray-100 transition"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="btn-submit-form"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold bg-primary hover:bg-primary/90 text-white shadow-sm transition transform active:scale-95"
          >
            <span id="btn-submit-text">Guardar Cliente</span>
            <span id="btn-submit-spinner" class="hidden w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    'https://zsddtosxnfqmbyxptkfs.supabase.co',
    'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpzZGR0b3N4bmZxbWJ5eHB0a2ZzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2NTc5MjEsImV4cCI6MjEwNDIzMzkyMX0.x7Oysn4OW3p5_Lwaj87vjdKOWvRyfeXKuQhGsO7XjGw'
  );

  interface Cliente {
    id_cliente: number;
    nombre: string;
    apellido: string;
    apellido_materno?: string | null;
    domicilio?: string | null;
    telefono?: string | null;
    correo?: string | null;
    rfc?: string | null;
    fecha_registro?: string;
  }

  let clientesList: Cliente[] = [];
  let toastTimer: any = null;

  // DOM Elements
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const clientCountBadge = document.getElementById('client-count-badge');
  const tableLoading = document.getElementById('table-loading');
  const tableContainer = document.getElementById('table-container');
  const tableBody = document.getElementById('clientes-table-body');
  const emptyState = document.getElementById('empty-state');
  const modal = document.getElementById('client-modal');
  const modalTitle = document.getElementById('modal-title');
  const clientForm = document.getElementById('client-form') as HTMLFormElement;
  const formClientId = document.getElementById('form-client-id') as HTMLInputElement;
  const formNombre = document.getElementById('form-nombre') as HTMLInputElement;
  const formApellido = document.getElementById('form-apellido') as HTMLInputElement;
  const formApellidoMaterno = document.getElementById('form-apellido-materno') as HTMLInputElement;
  const formDomicilio = document.getElementById('form-domicilio') as HTMLInputElement;
  const formTelefono = document.getElementById('form-telefono') as HTMLInputElement;
  const formRfc = document.getElementById('form-rfc') as HTMLInputElement;
  const formCorreo = document.getElementById('form-correo') as HTMLInputElement;
  const btnSubmitText = document.getElementById('btn-submit-text');
  const btnSubmitSpinner = document.getElementById('btn-submit-spinner');
  const btnSubmitForm = document.getElementById('btn-submit-form') as HTMLButtonElement;

  function showToast(message: string, isSuccess = true) {
    const toast = document.getElementById('toast');
    const toastIcon = document.getElementById('toast-icon');
    const toastMessage = document.getElementById('toast-message');

    if (!toast || !toastIcon || !toastMessage) return;

    if (toastTimer) clearTimeout(toastTimer);

    toastMessage.textContent = message;
    if (isSuccess) {
      toastIcon.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
      toast.className =
        'fixed bottom-5 right-5 z-50 max-w-sm w-full p-4 rounded-xl shadow-2xl text-sm font-medium transition-all duration-300 transform translate-y-0 opacity-100 flex items-center justify-between gap-3 bg-[#2D6A4F] text-white border-green-700';
    } else {
      toastIcon.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>';
      toast.className =
        'fixed bottom-5 right-5 z-50 max-w-sm w-full p-4 rounded-xl shadow-2xl text-sm font-medium transition-all duration-300 transform translate-y-0 opacity-100 flex items-center justify-between gap-3 bg-[#E63946] text-white border-red-700';
    }

    toastTimer = setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-4');
      setTimeout(() => toast.classList.add('hidden'), 300);
    }, 4000);
  }

  const toastClose = document.getElementById('toast-close');
  if (toastClose) {
    toastClose.addEventListener('click', () => {
      const toast = document.getElementById('toast');
      if (toast) {
        toast.classList.add('opacity-0', 'translate-y-4');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }
    });
  }

  function openCreateModal() {
    if (!modal) return;
    clientForm.reset();
    formClientId.value = '';
    if (modalTitle) modalTitle.textContent = 'Nuevo Cliente';
    if (btnSubmitText) btnSubmitText.textContent = 'Guardar Cliente';
    modal.classList.remove('hidden');
    formNombre.focus();
  }

  function openEditModal(cliente: Cliente) {
    if (!modal) return;
    clientForm.reset();
    formClientId.value = String(cliente.id_cliente);
    formNombre.value = cliente.nombre || '';
    formApellido.value = cliente.apellido || '';
    formApellidoMaterno.value = cliente.apellido_materno || '';
    formDomicilio.value = cliente.domicilio || '';
    formTelefono.value = cliente.telefono || '';
    formRfc.value = cliente.rfc || '';
    formCorreo.value = cliente.correo || '';

    if (modalTitle) modalTitle.textContent = 'Editar Cliente';
    if (btnSubmitText) btnSubmitText.textContent = 'Actualizar Cambios';
    modal.classList.remove('hidden');
    formNombre.focus();
  }

  function closeModal() {
    if (modal) modal.classList.add('hidden');
    clientForm.reset();
  }

  function renderTable(clientes: Cliente[]) {
    if (!tableBody || !emptyState || !clientCountBadge) return;

    tableBody.innerHTML = '';
    clientCountBadge.textContent = `${clientes.length} ${clientes.length === 1 ? 'cliente' : 'clientes'}`;

    if (clientes.length === 0) {
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');

    clientes.forEach((cliente) => {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-gray-50/80 transition-colors group cursor-pointer';
      
      tr.addEventListener('click', () => {
        window.location.href = `/admin/clientes/detalle?id=${cliente.id_cliente}`;
      });

      const nombre = cliente.nombre || '—';
      const apellidoCompleto = [cliente.apellido, cliente.apellido_materno].filter(Boolean).join(' ') || '—';
      const telefono = cliente.telefono || '—';
      const correo = cliente.correo || '—';
      const rfc = cliente.rfc || '—';

      tr.innerHTML = `
        <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">${nombre}</td>
        <td class="py-3.5 px-4 text-gray-700 whitespace-nowrap">${apellidoCompleto}</td>
        <td class="py-3.5 px-4 text-gray-600 whitespace-nowrap">
          ${telefono !== '—' ? `<a href="tel:${telefono}" class="hover:text-primary transition" onclick="event.stopPropagation()">
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              ${telefono}
            </span>
          </a>` : '—'}
        </td>
        <td class="py-3.5 px-4 text-gray-600 whitespace-nowrap">
          ${correo !== '—' ? `<a href="mailto:${correo}" class="hover:text-primary transition underline-offset-2 hover:underline" onclick="event.stopPropagation()">${correo}</a>` : '—'}
        </td>
        <td class="py-3.5 px-4 text-xs font-mono font-medium text-gray-500 whitespace-nowrap">${rfc}</td>
        <td class="py-3.5 px-4 text-center whitespace-nowrap">
          <div class="inline-flex items-center gap-1.5" onclick="event.stopPropagation()">
            <a
              href="/admin/clientes/detalle?id=${cliente.id_cliente}"
              class="p-1.5 rounded-lg text-gray-500 hover:text-primary hover:bg-primary/10 transition"
              title="Ver detalle"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
            </a>
            <button
              type="button"
              class="btn-edit p-1.5 rounded-lg text-gray-500 hover:text-primary hover:bg-primary/10 transition"
              title="Editar cliente"
              data-id="${cliente.id_cliente}"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
            </button>
            <button
              type="button"
              class="btn-delete p-1.5 rounded-lg text-gray-500 hover:text-secondary hover:bg-secondary/10 transition"
              title="Eliminar cliente"
              data-id="${cliente.id_cliente}"
              data-nombre="${nombre} ${apellidoCompleto}"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
          </div>
        </td>
      `;

      // Event listeners for edit and delete buttons
      const editBtn = tr.querySelector('.btn-edit');
      editBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        openEditModal(cliente);
      });

      const deleteBtn = tr.querySelector('.btn-delete');
      deleteBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        deleteCliente(cliente.id_cliente, `${nombre} ${apellidoCompleto}`);
      });

      tableBody.appendChild(tr);
    });
  }

  function filterClientes() {
    const term = (searchInput?.value || '').toLowerCase().trim();
    if (!term) {
      renderTable(clientesList);
      return;
    }

    const filtered = clientesList.filter((c) => {
      const nombre = (c.nombre || '').toLowerCase();
      const apellido = (c.apellido || '').toLowerCase();
      const apellido_materno = (c.apellido_materno || '').toLowerCase();
      const completo = `${nombre} ${apellido} ${apellido_materno}`;
      const tel = (c.telefono || '').toLowerCase();
      const rfc = (c.rfc || '').toLowerCase();
      const correo = (c.correo || '').toLowerCase();

      return (
        nombre.includes(term) ||
        apellido.includes(term) ||
        apellido_materno.includes(term) ||
        completo.includes(term) ||
        tel.includes(term) ||
        rfc.includes(term) ||
        correo.includes(term)
      );
    });

    renderTable(filtered);
  }

  async function loadClientes() {
    try {
      tableLoading?.classList.remove('hidden');
      tableContainer?.classList.add('hidden');

      const { data, error } = await supabase
        .from('clientes')
        .select('*')
        .order('id_cliente', { ascending: false });

      if (error) throw error;

      clientesList = data || [];
      filterClientes();
    } catch (err: any) {
      console.error('Error cargando clientes:', err);
      showToast(err.message || 'Error al cargar los clientes', false);
    } finally {
      tableLoading?.classList.add('hidden');
      tableContainer?.classList.remove('hidden');
    }
  }

  async function handleFormSubmit(e: Event) {
    e.preventDefault();

    const nombre = formNombre.value.trim();
    const apellido = formApellido.value.trim();
    const apellido_materno = formApellidoMaterno.value.trim() || null;
    const domicilio = formDomicilio.value.trim() || null;
    const telefono = formTelefono.value.trim() || null;
    const correo = formCorreo.value.trim() || null;
    const rfc = formRfc.value.trim().toUpperCase() || null;
    const id = formClientId.value ? parseInt(formClientId.value, 10) : null;

    if (!nombre || !apellido) {
      showToast('Nombre y apellido son obligatorios', false);
      return;
    }

    // Toggle button spinner
    btnSubmitSpinner?.classList.remove('hidden');
    btnSubmitForm.disabled = true;

    try {
      if (id) {
        // UPDATE
        const { error } = await supabase
          .from('clientes')
          .update({
            nombre,
            apellido,
            apellido_materno,
            domicilio,
            telefono,
            correo,
            rfc,
          })
          .eq('id_cliente', id);

        if (error) throw error;
        showToast('Cliente actualizado correctamente');
      } else {
        // CREATE
        const { error } = await supabase.from('clientes').insert([
          {
            nombre,
            apellido,
            apellido_materno,
            domicilio,
            telefono,
            correo,
            rfc,
          },
        ]);

        if (error) throw error;
        showToast('Cliente registrado con éxito');
      }

      closeModal();
      await loadClientes();
    } catch (err: any) {
      console.error('Error guardando cliente:', err);
      showToast(err.message || 'Error al guardar los datos del cliente', false);
    } finally {
      btnSubmitSpinner?.classList.add('hidden');
      btnSubmitForm.disabled = false;
    }
  }

  async function deleteCliente(id: number, nombre: string) {
    const ok = confirm(`¿Estás seguro de que deseas eliminar al cliente "${nombre}"?\n\nEsta acción eliminará también sus vehículos y trabajos asociados.`);
    if (!ok) return;

    try {
      const { error } = await supabase.from('clientes').delete().eq('id_cliente', id);
      if (error) throw error;

      showToast(`Cliente "${nombre}" eliminado correctamente`);
      await loadClientes();
    } catch (err: any) {
      console.error('Error eliminando cliente:', err);
      showToast(err.message || 'No se pudo eliminar el cliente', false);
    }
  }

  // Initial load
  loadClientes().then(() => {
    // Check if we need to auto-open the new or edit modal after loading data
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('new') === 'true') {
      const addBtn = document.getElementById('btn-open-create-modal');
      if (addBtn) addBtn.click();
      window.history.replaceState({}, document.title, window.location.pathname);
    } else if (urlParams.get('edit')) {
      const editId = parseInt(urlParams.get('edit'), 10);
      if (!isNaN(editId)) {
        const clienteToEdit = clientesList.find(c => c.id_cliente === editId);
        if (clienteToEdit) {
           openEditModal(clienteToEdit);
        }
      }
      window.history.replaceState({}, document.title, window.location.pathname);
    }
  });

  // Event Listeners
  document.getElementById('btn-open-create-modal')?.addEventListener('click', openCreateModal);
  document.getElementById('empty-btn-create')?.addEventListener('click', openCreateModal);
  document.getElementById('btn-close-modal')?.addEventListener('click', closeModal);
  document.getElementById('btn-cancel-modal')?.addEventListener('click', closeModal);
  clientForm?.addEventListener('submit', handleFormSubmit);
  searchInput?.addEventListener('input', filterClientes);

  // Close modal on click outside
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Initial load
  loadClientes();
</script>
