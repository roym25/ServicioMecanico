---
// src/layouts/AdminLayout.astro
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Dashboard', href: '/admin', icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>` },
  { label: 'Clientes', href: '/admin/clientes', icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>` },
  { label: 'Vehículos', href: '/admin/vehiculos', icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>` },
  { label: 'Trabajos', href: '/admin/trabajos', icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>` },
  { label: 'Configuración', href: '/admin/configuracion', icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>` },
];

function isActive(href: string) {
  if (href === '/admin') {
    return currentPath === '/admin' || currentPath === '/admin/';
  }
  return currentPath.startsWith(href);
}
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Servicio Mecánico Muñoz</title>
    <!-- Removed favicon.svg -->
    <style is:global>
      /* Mobile drawer expansion */
      @media (max-width: 767px) {
        #admin-sidebar.sidebar-expanded {
          width: 16rem !important;
          z-index: 50 !important;
          box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.3), 0 8px 10px -6px rgb(0 0 0 / 0.3);
        }
        #admin-sidebar.sidebar-expanded .label-text {
          display: inline !important;
        }
        #admin-sidebar.sidebar-expanded .logo-collapsed {
          display: none !important;
        }
        #admin-sidebar.sidebar-expanded .logo-expanded {
          display: flex !important;
        }
        #admin-sidebar.sidebar-expanded .nav-item-btn {
          justify-content: flex-start !important;
          padding-left: 1rem !important;
          padding-right: 1rem !important;
        }
      }

      /* Dark Mode Base Styles - Neutral Grays */
      html.dark body { background-color: #18181b !important; color: #f4f4f5 !important; }
      html.dark .bg-\[\#F8F9FA\] { background-color: #18181b !important; }
      html.dark header.bg-white { background-color: #27272a !important; border-color: #3f3f46 !important; }
      html.dark .bg-white { background-color: #27272a !important; border-color: #3f3f46 !important; }
      html.dark .bg-gray-50 { background-color: #202022 !important; border-color: #3f3f46 !important; }
      html.dark .border-gray-100, html.dark .border-gray-200 { border-color: #3f3f46 !important; }
      html.dark .divide-gray-100 > :not([hidden]) ~ :not([hidden]) { border-color: #3f3f46 !important; }
      
      /* Sidebar in Dark Mode */
      html.dark #admin-sidebar { background-color: #09090b !important; border-right: 1px solid #27272a !important; }
      html.dark #admin-sidebar .border-white\/10 { border-color: #27272a !important; }

      /* Dark Mode Text Colors (Using Attribute Selectors to bypass Tailwind escapes) */
      html.dark h1, html.dark h2, html.dark h3, html.dark h4 { color: #f4f4f5 !important; }
      html.dark [class*="text-[#1E3A5F]"], html.dark [class*="text-[#1e3a5f]"] { color: #f4f4f5 !important; }
      html.dark [class*="text-[#212529]"] { color: #f4f4f5 !important; }
      html.dark [class*="text-gray-900"], html.dark [class*="text-gray-800"] { color: #f4f4f5 !important; }
      html.dark [class*="text-gray-700"] { color: #d4d4d8 !important; }
      html.dark [class*="text-gray-600"] { color: #a1a1aa !important; }
      html.dark [class*="text-gray-500"] { color: #71717a !important; }
      html.dark [class*="text-gray-400"] { color: #52525b !important; }
      html.dark p.text-gray-600 { color: #a1a1aa !important; }
      
      /* Inputs and Controls */
      html.dark input, html.dark select, html.dark textarea { 
        background-color: #18181b !important; 
        color: #f4f4f5 !important; 
        border-color: #52525b !important; 
      }
      html.dark .hover\:bg-gray-50:hover { background-color: #3f3f46 !important; }
      html.dark .hover\:bg-gray-100:hover { background-color: #52525b !important; }
      
      /* SVG Icons specific fixes */
      html.dark #sidebar-toggle-btn { color: #a1a1aa !important; }
      html.dark #sidebar-toggle-btn:hover { color: #f4f4f5 !important; }
      html.dark #theme-toggle { color: #a1a1aa !important; }
      html.dark #theme-toggle:hover { color: #f4f4f5 !important; }
      html.dark .border-l.border-gray-200 { border-color: #3f3f46 !important; }
    </style>
    <script>
      // Early execution to prevent FOUC (Flash of Unstyled Content)
      if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-full bg-[#F8F9FA] text-[#212529] font-sans antialiased">
    <!-- Mobile Backdrop Overlay -->
    <div
      id="sidebar-overlay"
      class="fixed inset-0 bg-black/50 z-40 hidden md:hidden transition-opacity"
      aria-hidden="true"
    ></div>

    <!-- Fixed Sidebar (64px mobile icon-only, 256px desktop) -->
    <aside
      id="admin-sidebar"
      class="fixed top-0 left-0 z-40 h-screen w-16 md:w-64 bg-[#1E3A5F] text-white flex flex-col justify-between transition-all duration-200 ease-in-out shadow-lg"
      aria-label="Navegación principal"
    >
      <!-- Top: Logo & Navigation Links -->
      <div class="flex flex-col flex-1 min-h-0">
        <!-- Brand Header -->
        <div class="h-16 flex items-center justify-between px-3 md:px-5 border-b border-white/10">
          <a
            href="/admin"
            class="flex items-center gap-2.5 overflow-hidden font-bold text-white hover:opacity-90 transition-opacity"
            title="Servicio Mecánico Muñoz"
          >
            <!-- Collapsed logo (64px mobile) -->
            <span class="logo-collapsed md:hidden text-base font-bold whitespace-nowrap flex items-center gap-2">
              SMM
            </span>
            <!-- Expanded logo (desktop or mobile toggled) -->
            <span class="logo-expanded hidden md:flex items-center gap-2 text-[15px] lg:text-[17px] font-extrabold whitespace-nowrap">
              Servicio Mecánico Muñoz
            </span>
          </a>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 px-2 md:px-3 py-4 space-y-1.5 overflow-y-auto overflow-x-hidden">
          {navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class={`nav-item-btn flex items-center justify-center md:justify-start gap-3 px-2.5 md:px-3.5 py-3 rounded-xl transition-all duration-150 ${
                  active
                    ? 'bg-[#E63946] text-white font-semibold shadow-sm'
                    : 'text-white/80 hover:bg-white/10 hover:text-white font-medium'
                }`}
                title={item.label}
              >
                <span class="text-xl flex-shrink-0 flex items-center justify-center w-6 text-center" role="img" aria-label={item.label} set:html={item.icon} />
                <span class="label-text hidden md:inline whitespace-nowrap text-sm">
                  {item.label}
                </span>
              </a>
            );
          })}
        </nav>
      </div>

      <!-- Bottom: Logout Button -->
      <div class="p-2 md:p-3 border-t border-white/10">
        <button
          id="logout-btn"
          type="button"
          class="nav-item-btn w-full flex items-center justify-center md:justify-start gap-3 px-2.5 md:px-3.5 py-3 rounded-xl text-white/80 hover:bg-[#E63946] hover:text-white transition-all duration-150 font-medium cursor-pointer"
          title="Cerrar sesión"
        >
          <span class="text-xl flex-shrink-0 flex items-center justify-center w-6 text-center" role="img" aria-label="Cerrar sesión">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/>
            </svg>
          </span>
          <span class="label-text hidden md:inline whitespace-nowrap text-sm">
            Cerrar sesión
          </span>
        </button>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="ml-16 md:ml-64 min-h-screen flex flex-col bg-[#F8F9FA] transition-all duration-200">
      <!-- Top Bar -->
      <header class="sticky top-0 z-30 h-16 bg-white border-b border-gray-200 px-4 sm:px-6 lg:px-8 flex items-center justify-between shadow-xs">
        <div class="flex items-center gap-3">
          <!-- Mobile Sidebar Toggle Button -->
          <button
            id="sidebar-toggle-btn"
            type="button"
            class="md:hidden p-2 -ml-2 rounded-lg text-gray-600 hover:text-[#1E3A5F] hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#1E3A5F] cursor-pointer"
            aria-label="Alternar barra lateral"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>

          <!-- Page Title -->
          <h1 class="text-lg sm:text-xl font-bold text-[#1E3A5F] tracking-tight truncate">
            {title}
          </h1>
        </div>

        <!-- User Indicator and Theme Toggle -->
        <div class="flex items-center gap-3">
          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle"
            type="button"
            class="p-2 rounded-lg text-gray-400 hover:text-[#1E3A5F] hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#1E3A5F] cursor-pointer"
            aria-label="Alternar modo oscuro"
          >
            <!-- Sun Icon (shown in dark mode) -->
            <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
          </button>

          <div class="hidden sm:flex flex-col text-right leading-tight border-l border-gray-200 pl-3">
            <span id="user-display" class="text-xs font-semibold text-[#212529] truncate max-w-[160px] md:max-w-[220px]">Administrador</span>
            <span class="text-[11px] font-medium text-[#2D6A4F]">En línea</span>
          </div>
          <div class="w-9 h-9 rounded-full bg-[#1E3A5F]/10 border border-[#1E3A5F]/20 text-[#1E3A5F] flex items-center justify-center font-bold text-sm shadow-xs" title="Usuario Administrador">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>
            </svg>
          </div>
        </div>
      </header>

      <!-- Page Content -->
      <main class="flex-1 px-4 pt-2 pb-6 sm:px-6 sm:pt-3 lg:px-8 lg:pt-3">
        <slot />
      </main>
    </div>

    <!-- Client-side Scripts -->
    <script>
      import { createClient } from '@supabase/supabase-js';
      
      // Toggle Theme Logic
      const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
      const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
      const themeToggleBtn = document.getElementById('theme-toggle');

      // Setup icons based on current theme
      if (document.documentElement.classList.contains('dark')) {
        themeToggleLightIcon.classList.remove('hidden');
      } else {
        themeToggleDarkIcon.classList.remove('hidden');
      }

      themeToggleBtn.addEventListener('click', function() {
        themeToggleDarkIcon.classList.toggle('hidden');
        themeToggleLightIcon.classList.toggle('hidden');

        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });

      const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL || 'https://zsddtosxnfqmbyxptkfs.supabase.co',
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpzZGR0b3N4bmZxbWJ5eHB0a2ZzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2NTc5MjEsImV4cCI6MjEwNDIzMzkyMX0.x7Oysn4OW3p5_Lwaj87vjdKOWvRyfeXKuQhGsO7XjGw'
      );

      // Check auth
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/admin/login';
      } else if (session.user?.email) {
        const userDisplay = document.getElementById('user-display');
        if (userDisplay) {
          userDisplay.textContent = session.user.email;
        }
      }

      // Logout handler
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = '/admin/login';
      });

      // Mobile sidebar toggle handler
      const sidebar = document.getElementById('admin-sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      const toggleBtn = document.getElementById('sidebar-toggle-btn');

      function toggleSidebar() {
        const isExpanded = sidebar?.classList.contains('sidebar-expanded');
        if (isExpanded) {
          sidebar?.classList.remove('sidebar-expanded');
          overlay?.classList.add('hidden');
        } else {
          sidebar?.classList.add('sidebar-expanded');
          overlay?.classList.remove('hidden');
        }
      }

      toggleBtn?.addEventListener('click', toggleSidebar);
      overlay?.addEventListener('click', toggleSidebar);
    </script>
  </body>
</html>
