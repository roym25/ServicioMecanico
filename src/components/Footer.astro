---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];
---

<footer class="bg-primary text-white mt-auto">
  <!-- Contenido principal del pie de página -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      <!-- Columna 1: Marca y descripción -->
      <div class="space-y-4">
        <div class="flex items-center gap-2 text-xl font-bold">
          <span class="text-2xl" aria-hidden="true">🔧</span>
          <span class="font-extrabold tracking-tight">Servicio Mecánico</span>
        </div>
        <p class="text-gray-300 text-sm leading-relaxed">
          Taller mecánico profesional y de confianza. Ofrecemos soluciones integrales de mantenimiento preventivo, reparaciones especializadas y diagnóstico computarizado para mantener su vehículo en óptimas condiciones.
        </p>
      </div>

      <!-- Columna 2: Enlaces rápidos -->
      <div>
        <h3 class="text-lg font-semibold text-white mb-4 border-b border-white/20 pb-2 inline-block">
          Enlaces Rápidos
        </h3>
        <ul class="space-y-2.5 text-sm">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-gray-300 hover:text-white transition-colors duration-200 flex items-center gap-2 group"
              >
                <span class="text-secondary transition-transform group-hover:translate-x-1" aria-hidden="true">›</span>
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Información de contacto -->
      <div>
        <h3 class="text-lg font-semibold text-white mb-4 border-b border-white/20 pb-2 inline-block">
          Contacto
        </h3>
        <ul class="space-y-3 text-sm text-gray-300">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Av. Principal #123, Zona Industrial</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+525512345678" class="hover:text-white transition-colors">+52 (55) 1234-5678</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:contacto@serviciomecanico.com" class="hover:text-white transition-colors">contacto@serviciomecanico.com</a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Lun - Vie: 8:00 - 18:00<br />Sáb: 8:00 - 14:00</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Barra de copyright inferior -->
  <div class="border-t border-white/10 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm text-gray-400">
      <p>&copy; {currentYear} Servicio Mecánico. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
