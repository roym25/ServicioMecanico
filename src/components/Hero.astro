---
// src/components/Hero.astro
---

<section class="relative min-h-[calc(100vh-4rem)] md:min-h-[calc(100vh-5rem)] flex items-center justify-center overflow-hidden bg-gradient-to-br from-[#1E3A5F] via-[#182e4b] to-[#0f1c2d] text-white py-16 sm:py-24">
  <!-- Subtle background pattern / decorative overlay -->
  <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:24px_24px]"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>

  <!-- Decorative glow effects -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-primary/40 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-secondary/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10">
    <!-- Tagline / Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs sm:text-sm font-medium tracking-wide mb-6 backdrop-blur-sm">
      <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
      Atención especializada y repuestos garantizados
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-tight mb-6">
      Tu taller mecánico de <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-secondary">confianza</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-lg sm:text-xl md:text-2xl text-gray-200 max-w-3xl mx-auto leading-relaxed mb-10 font-normal">
      Servicio profesional, transparente y de calidad para tu vehículo
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5 max-w-md mx-auto">
      <a
        href="/servicios"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold rounded-lg bg-secondary text-white hover:bg-secondary/90 shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200"
      >
        <span>Ver Servicios</span>
        <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <a
        href="/contacto"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold rounded-lg bg-white/10 hover:bg-white/20 text-white border border-white/30 hover:border-white/50 backdrop-blur-sm hover:-translate-y-0.5 transition-all duration-200"
      >
        <span>Contáctanos</span>
      </a>
    </div>

    <!-- Quick Trust Badges -->
    <div class="mt-14 pt-8 border-t border-white/15 grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs sm:text-sm text-gray-300">
      <div class="flex items-center justify-center gap-2">
        <span class="text-green-400 font-bold">✓</span>
        <span>Presupuesto sin compromiso</span>
      </div>
      <div class="flex items-center justify-center gap-2">
        <span class="text-green-400 font-bold">✓</span>
        <span>Garantía en mano de obra</span>
      </div>
      <div class="flex items-center justify-center gap-2 col-span-2 sm:col-span-1">
        <span class="text-green-400 font-bold">✓</span>
        <span>Técnicos certificados</span>
      </div>
    </div>
  </div>
</section>
